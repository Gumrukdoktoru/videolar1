   "s": 31.116,
   "e": 31.996
  },
  {
   "text": "Yulaf.",
   "s": 31.996,
   "e": 32.876
  },
  {
   "text": "D şıkkı:",
   "s": 32.876,
   "e": 33.756
  },
  {
   "text": "Hayvan yemi olarak kullanılan kurutulmuş fiğ otu.",
   "s": 33.756,
   "e": 37.036
  },
  {
   "text": "E şıkkı:",
   "s": 37.036,
   "e": 37.916
  },
  {
   "text": "Tane sorgum.",
   "s": 37.916,
   "e": 38.993
  },
  {
   "text": "3 saniye, düşünün!",
   "s": 39.676,
   "e": 41.564
  },
  {
   "text": "Cevap:",
   "s": 45.914,
   "e": 46.794
  },
  {
   "text": "D şıkkı.",
   "s": 46.794,
   "e": 47.834
  },
  {
   "text": "Fiğ, hayvan yemi olarak yetiştirilen bir yem bitkisidir;",
   "s": 47.834,
   "e": 51.154
  },
  {
   "text": "tane olarak yenmez.",
   "s": 51.154,
   "e": 52.714
  },
  {
