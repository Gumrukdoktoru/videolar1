   "s": 26.076,
   "e": 28.966
  },
  {
   "text": "B şıkkı:",
   "s": 29.116,
   "e": 29.996
  },
  {
   "text": "Karabuğday.",
   "s": 29.996,
   "e": 31.116
  },
  {
