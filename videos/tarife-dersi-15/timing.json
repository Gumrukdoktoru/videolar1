 "captions": [
  {
   "text": "Merhaba arkadaşlar, Gümrük Koçu'yla tarife derslerinin",
   "s": 1.744,
   "e": 4.88
  },
  {
   "text": "15'incisine hoş geldiniz.",
   "s": 4.88,
   "e": 6.8
  },
  {
   "text": "Bugün 3 soru var:",
   "s": 6.8,
   "e": 8.16
  },
  {
   "text": "nevresim takımı, okey takımı ve bölüm yapısı.",
   "s": 8.16,
   "e": 11.44
  },
  {
   "text": "Ekip hazır:",
   "s": 11.44,
   "e": 12.4
  },
  {
   "text": "Stajyer, Yardımcı, Gümrükçü Baba ve Cano.",
   "s": 12.4,
   "e": 15.72
  },
  {
   "text": "Kâğıt kalem hazırsa, başlayalım.",
   "s": 15.72,
   "e": 17.889
  },
  {
   "text": "Birinci soru.",
   "s": 18.639,
   "e": 19.839
  },
  {
   "text": "Pamuklu dokuma kumaştan bir nevresim,",
   "s": 19.839,
   "e": 22.319
  },
  {
   "text": "bir çarşaf ve iki yastık kılıfından oluşan,",
   "s": 22.319,
   "e": 25.119
  },
  {
   "text": "perakende satış ambalajındaki nevresim takımı",
   "s": 25.119,
   "e": 27.919
  },
  {
   "text": "hangi tarife pozisyonunda sınıflandırılır?",
