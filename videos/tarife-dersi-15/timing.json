  },
  {
   "text": "B şıkkı.",
   "s": 51.285,
   "e": 52.325
  },
  {
   "text": "Nevresim, yani yorgan kılıfı,",
   "s": 52.325,
   "e": 54.645
  },
  {
   "text": "çarşaf ve yastık kılıfları,",
