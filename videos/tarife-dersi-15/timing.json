   "s": 209.171,
   "e": 210.971
  },
  {
   "text": "D şıkkı:",
   "s": 210.971,
   "e": 211.851
  },
  {
   "text": "Piyano, piyano taburesi,",
   "s": 211.851,
   "e": 213.691
  },
  {
   "text": "basılı nota.",
   "s": 213.691,
   "e": 214.891
  },
  {
   "text": "E şıkkı:",
   "s": 214.891,
   "e": 215.771
  },
  {
   "text": "Metronom, gitar teli, gitar kılıfı.",
   "s": 215.771,
   "e": 218.501
  },
  {
   "text": "3 saniye, düşünün!",
   "s": 218.8,
   "e": 220.615
  },
  {
   "text": "Cevap:",
   "s": 224.965,
   "e": 225.695
  },
  {
   "text": "A şıkkı.",
   "s": 225.765,
   "e": 226.725
  },
  {
   "text": "Pusula 90.14'te, akort düdüğü 92.09'da,",
   "s": 226.725,
   "e": 230.965
  },
  {
   "text": "duvar saati 91.05'te;",
   "s": 230.965,
   "e": 233.485
  },
  {
   "text": "üçü de 90 ile 92 arasındaki fasıllardan oluşan",
   "s": 233.485,
   "e": 236.805
  },
  {
   "text": "18. bölümdedir.",
   "s": 236.805,
   "e": 238.615
  },
  {
   "text": "Diğer şıklarda en az bir yabancı var:",
   "s": 238.645,
   "e": 241.205
  },
  {
   "text": "Optik olarak işlenmemiş gözlük camı 70.15'te,",
   "s": 241.205,
   "e": 244.525
  },
  {
   "text": "13. bölümde.",
   "s": 244.525,
   "e": 245.845
  },
  {
   "text": "Ahşap mücevher kutusu 44.20'de,",
   "s": 245.845,
   "e": 248.405
  },
  {
   "text": "9. bölümde.",
   "s": 248.405,
   "e": 249.685
  },
  {
   "text": "Ayrı gelen gitar kılıfı ise 42.02'de,",
   "s": 249.685,
   "e": 252.725
  },
  {
   "text": "8. bölümde.",
   "s": 252.725,
   "e": 253.885
  },
  {
   "text": "Piyano taburesi 94.01'de,",
   "s": 253.885,
   "e": 256.485
  },
  {
   "text": "basılı nota 49.04'te.",
   "s": 256.485,
   "e": 259.017
  },
  {
   "text": "Tuzak nerede?",
   "s": 259.847,
   "e": 261.337
  },
  {
   "text": "Stajyerimiz, gitar kılıfı da gitarın aksesuarıdır,",
   "s": 261.367,
   "e": 264.807
  },
  {
   "text": "metronom ve gitar teli gibi 92.09'a girer diye",
   "s": 264.807,
   "e": 268.567
  },
  {
   "text": "E şıkkını seçti.",
   "s": 268.567,
   "e": 269.927
  },
  {
   "text": "Hayır!",
   "s": 269.927,
   "e": 270.647
  },
  {
   "text": "Müzik aleti mahfazaları 42.02'nin metninde adıyla",
   "s": 270.647,
   "e": 274.247
  },
  {
   "text": "sayılır;",
   "s": 274.247,
   "e": 274.887
  },
  {
   "text": "ayrı gelen gitar kılıfı 8. bölümdedir.",
   "s": 274.887,
   "e": 277.607
  },
  {
   "text": "Bir de dikkat:",
   "s": 277.607,
   "e": 278.567
  },
  {
   "text": "Gitarla birlikte getirilen,",
   "s": 278.567,
   "e": 280.207
  },
  {
   "text": "ona uygun yapılmış kılıf ise 5. kural gereği gitarla",
   "s": 280.207,
   "e": 283.527
  },
  {
   "text": "birlikte sınıflandırılır.",
   "s": 283.527,
   "e": 285.297
  },
  {
   "text": "Gümrükçü Baba'nın kısa yolu:",
   "s": 285.367,
   "e": 287.127
  },
  {
   "text": "Ayrı geldiyse kılıf, kendi yerine.",
   "s": 287.127,
   "e": 289.483
  },
  {
   "text": "Koçun notu:",
   "s": 290.313,
   "e": 291.473
  },
  {
   "text": "Bugünün 3 kuralı.",
   "s": 291.473,
   "e": 292.913
  },
  {
   "text": "Bir:",
   "s": 292.913,
   "e": 293.646
  },
  {
   "text": "Takım kelimesine değil eşyaya bakın;",
   "s": 293.646,
   "e": 295.993
  },
  {
   "text": "nevresim takımı 63.02'dir.",
   "s": 295.993,
   "e": 298.673
  },
  {
   "text": "İki:",
   "s": 298.673,
   "e": 299.313
  },
  {
   "text": "95. fasılda işlev belirler;",
   "s": 299.313,
   "e": 301.753
  },
  {
   "text": "okey bir masa oyunudur,",
   "s": 301.753,
   "e": 303.153
  },
  {
   "text": "95.04.",
   "s": 303.153,
   "e": 304.873
  },
  {
   "text": "Üç:",
   "s": 304.873,
   "e": 305.473
  },
  {
   "text": "Bölüm sorusunda her eşyanın faslını bulun;",
   "s": 305.473,
   "e": 308.153
  },
  {
   "text": "18. bölüm, 90 ile 92 arasındaki fasıllardır.",
   "s": 308.153,
   "e": 312.112
  },
  {
   "text": "Bugünün cevap anahtarı:",
   "s": 312.862,
   "e": 314.472
  },
  {
   "text": "Birinci soru B, ikinci soru C,",
   "s": 314.622,
   "e": 317.502
  },
  {
   "text": "üçüncü soru A.",
   "s": 317.502,
   "e": 318.942
  },
  {
   "text": "Kaç tanesini bildiniz?",
   "s": 318.942,
   "e": 320.302
  },
  {
   "text": "Yorumlara yazın.",
   "s": 320.302,
   "e": 321.422
  },
  {
   "text": "Böylece tarife derslerinin 15'incisini de tamamladık.",
   "s": 321.422,
   "e": 324.942
  },
  {
   "text": "Bu ders işinize yaradıysa abone olmayı ve paylaşmayı",
   "s": 324.942,
   "e": 328.142
  },
  {
   "text": "unutmayın.",
   "s": 328.142,
   "e": 328.862
  },
  {
   "text": "Bir sonraki derste görüşmek üzere.",
   "s": 328.862,
   "e": 330.622
  },
  {
   "text": "Hoşça kalın!",
   "s": 330.622,
   "e": 331.633
  }
 ]
