 "captions": [
  {
   "text": "Merhaba arkadaşlar, Gümrük Koçu'yla tarife derslerinin",
   "s": 1.69,
   "e": 4.8
  },
  {
   "text": "ikincisine hoş geldiniz.",
   "s": 4.8,
   "e": 6.47
  },
  {
   "text": "Bugün yine 3 soru var:",
   "s": 6.47,
   "e": 8.01
  },
  {
   "text": "genel yorum kuralları, demir ve çelikten ev eşyası",
   "s": 8.01,
   "e": 11.2
  },
  {
   "text": "ve büro makineleri.",
   "s": 11.2,
   "e": 12.55
  },
  {
   "text": "Ekip hazır:",
   "s": 12.55,
   "e": 13.55
  },
  {
   "text": "Stajyer, Yardımcı, Gümrükçü Baba ve Cano.",
   "s": 13.55,
   "e": 16.89
  },
  {
   "text": "Kâğıt kalem hazırsa, başlayalım.",
   "s": 16.89,
   "e": 19.169
  },
  {
   "text": "Birinci soru.",
   "s": 20.019,
   "e": 21.179
  },
  {
   "text": "Tarifenin yorumuna ilişkin genel kurallarla ilgili",
   "s": 21.179,
   "e": 24.139
  },
  {
   "text": "aşağıdaki ifadelerden hangisi yanlıştır?",
   "s": 24.139,
   "e": 27.219
  },
  {
   "text": "A şıkkı:",
   "s": 27.219,
   "e": 28.419
  },
  {
   "text": "Eksik veya bitirilmemiş eşya,",
   "s": 28.419,
   "e": 30.169
  },
  {
   "text": "sunulduğunda tamamlanmış eşyanın esas niteliğine",
   "s": 30.169,
   "e": 33.329
  },
  {
   "text": "sahipse, tamamlanmış eşya gibi sınıflandırılır.",
   "s": 33.329,
   "e": 36.629
  },
  {
   "text": "B şıkkı:",
   "s": 36.629,
   "e": 37.189
  },
  {
   "text": "Bölüm, fasıl ve tali fasıl başlıkları,",
   "s": 37.189,
   "e": 39.919
  },
  {
   "text": "eşyanın tarifedeki yerinin saptanmasında yasal",
   "s": 39.919,
   "e": 43.359
  },
  {
   "text": "dayanak oluşturur.",
   "s": 43.359,
   "e": 44.789
  },
  {
   "text": "C şıkkı:",
   "s": 44.789,
   "e": 45.279
  },
  {
   "text": "Belli bir eşyaya göre yapılmış,",
   "s": 45.279,
   "e": 47.169
  },
  {
   "text": "uzun süreli kullanıma uygun mahfazalar,",
   "s": 47.169,
   "e": 49.549
  },
  {
   "text": "eşyayla birlikte sunulduğunda onunla birlikte",
   "s": 49.549,
   "e": 52.419
  },
  {
   "text": "sınıflandırılır.",
   "s": 52.419,
   "e": 53.909
  },
  {
   "text": "D şıkkı:",
   "s": 53.909,
   "e": 54.399
  },
  {
   "text": "ilk 3 kurala göre sınıflandırılamayan eşya,",
   "s": 54.399,
   "e": 57.139
  },
  {
   "text": "en çok benzediği eşyanın pozisyonunda sınıflandırılır.",
   "s": 57.139,
   "e": 60.969
  },
  {
   "text": "E şıkkı:",
   "s": 61.109,
   "e": 61.519
  },
  {
   "text": "Alt pozisyonlarda yalnızca aynı seviyedeki alt",
   "s": 61.519,
   "e": 64.969
  },
  {
   "text": "pozisyonlar karşılaştırılır.",
   "s": 64.969,
   "e": 67.609
  },
  {
   "text": "3 saniye, düşünün!",
   "s": 67.609,
   "e": 69.769
  },
  {
   "text": "Cevap:",
   "s": 74.262,
   "e": 74.612
  },
  {
   "text": "B şıkkı.",
   "s": 74.612,
   "e": 75.832
  },
  {
   "text": "Birinci kurala göre bölüm,",
   "s": 76.002,
   "e": 77.922
  },
  {
   "text": "fasıl ve tali fasıl başlıkları sadece gösterici",
   "s": 77.922,
   "e": 80.802
  },
  {
   "text": "niteliktedir;",
   "s": 80.802,
   "e": 81.882
  },
  {
   "text": "yasal dayanak oluşturmaz.",
   "s": 81.882,
   "e": 83.562
  },
  {
   "text": "Sınıflandırma, pozisyon metinlerine ve bölüm ya",
   "s": 83.562,
   "e": 86.522
  },
  {
   "text": "da fasıl notlarına göre yapılır.",
   "s": 86.522,
   "e": 88.672
  },
  {
   "text": "Diğer ifadeler doğru:",
   "s": 88.672,
   "e": 90.232
  },
  {
   "text": "A şıkkı ikinci kuralın a bendi,",
   "s": 90.232,
   "e": 92.512
  },
  {
   "text": "C şıkkı beşinci kural, D şıkkı dördüncü kural,",
   "s": 92.512,
   "e": 95.932
  },
  {
   "text": "E şıkkı ise altıncı kural.",
   "s": 95.932,
   "e": 98.043
  },
  {
   "text": "Tuzak nerede?",
   "s": 98.883,
   "e": 100.123
  },
  {
   "text": "Stajyerimiz, ikinci faslın başlığı etler ve yenilen",
   "s": 100.333,
   "e": 103.903
  },
  {
   "text": "sakatat diye hayvan bağırsağını ikinci fasla koydu.",
   "s": 103.903,
   "e": 106.983
  },
  {
   "text": "Hayır!",
   "s": 107.123,
   "e": 108.003
  },
  {
   "text": "İkinci faslın notu bağırsakları açıkça hariç tutar;",
   "s": 108.013,
   "e": 110.993
  },
  {
   "text": "doğru yer 05.04.",
   "s": 110.993,
   "e": 113.123
  },
  {
   "text": "Başlık yol gösterir, karar notla verilir.",
   "s": 113.133,
   "e": 115.693
  },
  {
   "text": "Bir de dördüncü kurala dikkat:",
   "s": 115.693,
   "e": 117.723
  },
  {
   "text": "Kıymete ya da ticari miktara bakılmaz;",
   "s": 117.733,
   "e": 119.993
  },
  {
   "text": "en çok benzeyen eşyaya bakılır.",
