   "text": "Gümrükçü Baba hemen uyardı:",
   "s": 266.07,
   "e": 267.98
  },
  {
   "text": "Pozisyon metni eşyayı adıyla sayıyorsa,",
   "s": 267.98,
   "e": 270.48
  },
  {
   "text": "en özel tanım odur!",
   "s": 270.48,
   "e": 271.92
  },
  {
   "text": "Bir de sayaçlara dikkat:",
   "s": 271.92,
   "e": 273.34
  },
  {
   "text": "Sadece sayan ya da tek tek ekleyen düzenek toplama",
   "s": 273.34,
   "e": 276.23
  },
  {
   "text": "tertibatı sayılmaz;",
   "s": 276.23,
   "e": 277.72
  },
  {
   "text": "devir ve üretim sayaçları 90.29'da yer alır.",
   "s": 277.72,
   "e": 281.073
  },
  {
   "text": "Koçun notu:",
   "s": 281.953,
   "e": 282.823
  },
  {
   "text": "Bugünün 3 kuralı.",
   "s": 282.873,
   "e": 284.513
  },
  {
   "text": "Bir:",
   "s": 284.513,
   "e": 285.063
  },
  {
   "text": "Başlık yol gösterir;",
