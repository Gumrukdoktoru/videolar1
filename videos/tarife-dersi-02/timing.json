   "e": 286.903
  },
  {
   "text": "karar, pozisyon metni ve notlarla verilir.",
   "s": 286.913,
   "e": 289.913
  },
  {
   "text": "İki:",
   "s": 289.913,
   "e": 290.753
  },
  {
   "text": "Başka maddeden bir aksesuar,",
   "s": 290.803,
   "e": 292.633
  },
  {
   "text": "esas niteliği değiştirmiyorsa sonucu da değiştirmez.",
   "s": 292.633,
   "e": 295.833
  },
  {
   "text": "Üç:",
   "s": 295.833,
   "e": 296.423
  },
  {
   "text": "Pozisyon metni eşyayı adıyla sayıyorsa,",
   "s": 296.423,
   "e": 299.263
  },
  {
   "text": "önce oraya bakın.",
   "s": 299.263,
   "e": 300.672
  },
  {
   "text": "Bugünün cevap anahtarı:",
   "s": 301.482,
   "e": 303.082
  },
  {
   "text": "Birinci soru B, ikinci soru D,",
   "s": 303.082,
   "e": 305.952
