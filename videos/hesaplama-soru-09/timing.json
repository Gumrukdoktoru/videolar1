 "captions": [
  {
   "text": "Merhaba arkadaşlar, Gümrük Koçu'yla vergi hesaplama",
   "s": 1.68,
   "e": 4.76
  },
  {
   "text": "derslerinin dokuzuncusuna hoş geldiniz.",
   "s": 4.76,
   "e": 7.28
  },
  {
   "text": "Bugünün konusu tarım payı:",
   "s": 7.28,
   "e": 9.2
  },
  {
   "text": "bileşim kodu, T1 ya da T2 tutarı,",
   "s": 9.2,
   "e": 12.48
  },
  {
   "text": "net ağırlık ve KDV matrahı.",
   "s": 12.48,
   "e": 15.08
  },
  {
   "text": "Küçük bir seçim, sonucu değiştirir.",
   "s": 15.08,
   "e": 17.52
  },
  {
   "text": "Kâğıt kalem hazırsa, başlayalım.",
   "s": 17.52,
   "e": 19.796
  },
  {
   "text": "Önce soruyu okuyalım.",
   "s": 20.546,
   "e": 22.066
  },
  {
   "text": "B firması, Malezya menşeli ve Malezya'dan gelen",
   "s": 22.066,
   "e": 25.346
  },
  {
   "text": "gofret ithal ediyor.",
   "s": 25.346,
   "e": 26.786
  },
  {
   "text": "CIF kıymet 24.000 avro.",
   "s": 26.786,
   "e": 29.346
  },
  {
   "text": "Net ağırlık 6.000 kilogram,",
   "s": 29.346,
   "e": 31.266
  },
  {
   "text": "brüt ağırlık 6.300 kilogram.",
   "s": 31.266,
   "e": 33.666
  },
  {
   "text": "Bileşim tablosuna göre tarım payı kodu 7225:",
