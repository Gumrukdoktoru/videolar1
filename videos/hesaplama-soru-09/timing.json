   "e": 37.506
  },
  {
   "text": "T1 tutarı 100 kilogram başına 40 avro,",
   "s": 37.506,
   "e": 40.586
  },
  {
   "text": "T2 tutarı 25 avro.",
   "s": 40.586,
   "e": 42.706
  },
  {
   "text": "Gümrük vergisi %8, KDV %10,",
