 "captions": [
  {
   "text": "Merhaba arkadaşlar, Gümrük Koçu'yla tarife derslerinin",
   "s": 1.68,
   "e": 4.88
  },
  {
   "text": "altıncısına hoş geldiniz.",
   "s": 4.88,
   "e": 6.64
  },
  {
   "text": "Bugün yine 3 soru var:",
   "s": 6.64,
   "e": 8.28
  },
  {
   "text": "tarife cetvelinin yasal dayanağı,",
   "s": 8.28,
   "e": 10.24
  },
  {
   "text": "kod seviyeleri ve meyve faslı.",
   "s": 10.24,
   "e": 12.52
  },
  {
   "text": "Ekip hazır:",
   "s": 12.52,
   "e": 13.52
  },
  {
   "text": "Stajyer, Yardımcı, Gümrükçü Baba ve Cano.",
   "s": 13.52,
   "e": 16.827
  },
  {
   "text": "Kâğıt kalem hazırsa, başlayalım.",
   "s": 16.827,
   "e": 19.012
  },
  {
   "text": "Birinci soru.",
   "s": 19.762,
   "e": 21.012
  },
  {
   "text": "Gümrük Giriş Tarife Cetveli ile ilgili aşağıdaki",
   "s": 21.042,
   "e": 23.842
  },
  {
   "text": "ifadelerden hangisi doğrudur?",
   "s": 23.842,
   "e": 25.932
  },
  {
   "text": "A şıkkı:",
   "s": 26.162,
   "e": 27.202
  },
  {
   "text": "Cetvel Brüksel Nomanklatürü esas alınarak düzenlenmiştir;",
   "s": 27.202,
   "e": 30.962
  },
  {
   "text": "pozisyonlarını değiştirmeye Cumhurbaşkanı yetkilidir.",
   "s": 30.962,
   "e": 34.332
  },
  {
   "text": "B şıkkı:",
   "s": 34.402,
   "e": 35.442
  },
  {
   "text": "Cetvel Armonize Sistem Nomanklatürü esas alınarak",
   "s": 35.442,
   "e": 38.442
  },
  {
   "text": "düzenlenmiştir;",
   "s": 38.442,
   "e": 39.522
  },
  {
   "text": "pozisyonlarını değiştirmeye Ticaret Bakanlığı",
   "s": 39.522,
   "e": 42.122
  },
  {
   "text": "yetkilidir.",
   "s": 42.122,
   "e": 43.212
  },
  {
   "text": "C şıkkı:",
   "s": 43.282,
   "e": 44.322
  },
  {
   "text": "Cetvel Dünya Gümrük Örgütü tarafından yayımlanır;",
   "s": 44.322,
   "e": 47.522
  },
  {
   "text": "ülkeler pozisyonlarını değiştiremez.",
   "s": 47.522,
   "e": 50.092
  },
  {
   "text": "D şıkkı:",
   "s": 50.162,
   "e": 51.202
  },
  {
   "text": "Cetvel Armonize Sistem Nomanklatürü esas alınarak",
   "s": 51.202,
   "e": 54.162
  },
  {
   "text": "düzenlenmiştir;",
   "s": 54.162,
   "e": 55.282
  },
  {
   "text": "pozisyonlarını ve notlarını değiştirmeye Cumhurbaşkanı",
   "s": 55.282,
   "e": 58.242
  },
  {
   "text": "yetkilidir.",
   "s": 58.242,
   "e": 59.372
  },
  {
   "text": "E şıkkı:",
   "s": 59.442,
   "e": 60.482
  },
  {
   "text": "Cetvelin ilk 6 hanesi ulusal düzeyde belirlenir;",
