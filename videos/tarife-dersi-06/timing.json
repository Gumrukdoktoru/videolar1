   "e": 64.002
  },
  {
   "text": "Armonize Sistem yalnızca fasılları belirler.",
   "s": 64.002,
   "e": 67.412
  },
  {
   "text": "3 saniye, düşünün!",
   "s": 67.762,
   "e": 69.645
  },
  {
   "text": "Cevap:",
