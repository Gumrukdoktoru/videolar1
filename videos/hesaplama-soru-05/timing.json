 "captions": [
  {
   "text": "Merhaba arkadaşlar, Gümrük Koçu'yla vergi hesaplama",
   "s": 1.68,
   "e": 4.64
  },
  {
   "text": "derslerinin beşincisine hoş geldiniz.",
   "s": 4.64,
   "e": 7.04
  },
  {
   "text": "Bugünün konusu gümrük kıymeti:",
   "s": 7.04,
   "e": 9.2
  },
  {
   "text": "Faturadaki fiyata hangi ödemeler eklenir,",
   "s": 9.2,
   "e": 11.64
  },
  {
   "text": "hangileri eklenmez?",
   "s": 11.64,
   "e": 13.04
  },
  {
   "text": "Komisyon, tasarım, çoğaltma hakkı ve montaj ücreti",
   "s": 13.04,
   "e": 16.48
  },
  {
   "text": "aynı soruda.",
   "s": 16.48,
   "e": 17.493
  },
  {
   "text": "Kâğıt kalem hazırsa, başlayalım.",
   "s": 17.493,
   "e": 19.639
  },
  {
   "text": "Önce soruyu okuyalım.",
   "s": 20.389,
   "e": 21.909
  },
  {
   "text": "T firması, Almanya'dan 50 adet endüstriyel dikiş",
   "s": 21.909,
   "e": 25.269
  },
  {
   "text": "makinesi ithal ediyor.",
   "s": 25.269,
   "e": 26.709
  },
  {
   "text": "Makinenin tanesi FOB 1.200 avro.",
   "s": 26.709,
   "e": 29.949
  },
  {
   "text": "Türkiye'ye kadar navlun 2.500,",
   "s": 29.949,
   "e": 32.269
  },
  {
   "text": "sigorta 500 avro.",
   "s": 32.269,
   "e": 33.749
  },
  {
   "text": "Firma ayrıca satıcının acentesine 3.000 avro satış",
   "s": 33.749,
   "e": 36.949
  },
  {
   "text": "komisyonu, kendi satın alma temsilcisine 1.500",
   "s": 36.949,
   "e": 40.069
  },
  {
   "text": "avro komisyon ödüyor.",
   "s": 40.069,
   "e": 41.469
  },
  {
   "text": "İtalya'da hazırlanıp üreticiye bedelsiz verilen",
   "s": 41.469,
   "e": 44.189
  },
  {
   "text": "tasarım için 4.000 avro harcamış.",
   "s": 44.189,
   "e": 46.389
  },
  {
   "text": "Makinelerin Türkiye'de çoğaltılması hakkı için",
   "s": 46.389,
   "e": 48.789
  },
  {
   "text": "6.000 avro, ithalattan sonra yapılacak montaj",
   "s": 48.789,
   "e": 51.669
  },
  {
   "text": "için faturada ayrıca gösterilen 2.000 avro ödeyecek.",
   "s": 51.669,
   "e": 54.896
  },
  {
   "text": "Bir avro 40 lira.",
   "s": 54.896,
   "e": 56.309
  },
  {
   "text": "Soru şu:",
   "s": 56.309,
   "e": 57.189
  },
  {
   "text": "Eşyanın gümrük kıymeti kaç Türk lirasıdır?",
   "s": 57.189,
   "e": 60.11
  },
  {
   "text": "Şıklarımız şöyle.",
   "s": 60.86,
   "e": 62.3
  },
  {
