  {
   "text": "bir arada.",
   "s": 15.48,
   "e": 16.2
  },
  {
   "text": "Kâğıt kalem hazırsa, başlayalım.",
   "s": 16.2,
   "e": 18.37
  },
  {
   "text": "Önce soruyu okuyalım.",
   "s": 19.228,
