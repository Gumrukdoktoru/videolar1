  },
  {
   "text": "konuşacağız:",
   "s": 8.23,
   "e": 9.14
  },
  {
   "text": "Bu klima multi split mi,",
   "s": 9.14,
   "e": 11.07
  },
  {
   "text": "yoksa VRF mi?",
   "s": 11.07,
   "e": 12.57
  },
  {
   "text": "Gümrükler Genel Müdürlüğü,",
   "s": 12.57,
   "e": 14.19
  },
  {
   "text": "1 Ekim 2026 tarihli yazısıyla bu sorunun cevabını",
   "s": 14.19,
   "e": 17.7
  },
  {
   "text": "dört net teknik kritere bağladı.",
   "s": 17.7,
   "e": 20.04
  },
  {
   "text": "Hadi, adım adım inceleyelim.",
   "s": 20.04,
   "e": 21.886
  },
  {
   "text": "Önce sorunu görelim.",
   "s": 22.686,
   "e": 24.206
  },
  {
   "text": "Bölge müdürlüklerinden gelen yazılarda şu tespit",
   "s": 24.206,
   "e": 26.806
  },
  {
   "text": "yapılmış:",
   "s": 26.806,
   "e": 27.666
  },
  {
   "text": "Farklı üniversiteler, multi split klimalar için",
   "s": 27.666,
   "e": 30.376
  },
  {
   "text": "farklı kriterlere dayanan teknik raporlar düzenlemiş.",
   "s": 30.376,
   "e": 33.606
  },
  {
   "text": "Sonuç:",
   "s": 33.606,
   "e": 34.436
  },
  {
   "text": "Hangi kriterin esas alınacağı konusunda uygulama",
   "s": 34.436,
   "e": 37.016
  },
  {
   "text": "farklılıkları, ve eşyanın tarife pozisyonunda",
   "s": 37.016,
   "e": 39.826
  },
  {
   "text": "tereddüt.",
   "s": 39.826,
   "e": 40.926
  },
  {
   "text": "Bunun üzerine Gümrükler Genel Müdürlüğü,",
   "s": 41.737,
   "e": 44.117
  },
  {
   "text": "konuyu İthalat Genel Müdürlüğüne iletti.",
   "s": 44.117,
   "e": 46.557
  },
  {
   "text": "İthalat Genel Müdürlüğü de klimaların iç ve dış",
   "s": 46.557,
   "e": 49.247
  },
  {
   "text": "ünitelerine ilişkin teknik bilgilerini paylaştı.",
   "s": 49.247,
   "e": 52.257
  },
  {
   "text": "Bu bilgiler ve mevcut teknik raporlar birlikte",
   "s": 52.257,
   "e": 55.187
  },
  {
   "text": "incelendi.",
   "s": 55.187,
   "e": 56.043
  },
  {
   "text": "İnceleme şunu gösterdi:",
   "s": 56.843,
   "e": 58.443
  },
  {
   "text": "Multi split ve VRF sistemlerin bazı ortak özellikleri",
   "s": 58.443,
   "e": 61.993
  },
  {
   "text": "var;",
   "s": 61.993,
   "e": 62.443
  },
  {
   "text": "ama teknik mimari ve çalışma prensibi bakımından",
   "s": 62.443,
   "e": 65.333
  },
  {
   "text": "birbirinden ayrılıyorlar.",
   "s": 65.333,
   "e": 67.003
  },
  {
   "text": "Ve işte ilk tuzak:",
   "s": 67.003,
   "e": 69.003
  },
  {
   "text": "Her iki sistemde de bir dış üniteye birden fazla",
   "s": 69.003,
   "e": 71.853
  },
  {
   "text": "iç ünite bağlanabilir.",
   "s": 71.853,
   "e": 73.403
  },
  {
   "text": "Ama bu, tek başına bir sistemi VRF yapmaz!",
   "s": 73.403,
   "e": 76.922
  },
  {
   "text": "Multi split sistemde temel mantık basit:",
   "s": 77.722,
   "e": 80.362
  },
  {
   "text": "Bir dış ünite, birden fazla iç üniteyi çalıştırır.",
   "s": 80.362,
   "e": 83.802
  },
  {
   "text": "VRF'yi karakterize eden özellikler ise şunlar:",
   "s": 83.802,
   "e": 87.162
  },
  {
   "text": "Soğutucu akışkan debisi,",
   "s": 87.162,
   "e": 89.192
  },
  {
   "text": "sistemdeki anlık yüklere göre değişken olarak",
   "s": 89.192,
   "e": 91.682
  },
  {
   "text": "kontrol edilir.",
   "s": 91.682,
   "e": 92.682
  },
  {
   "text": "Akışkan, ortak ana hatlar ve branşmanlar üzerinden",
   "s": 92.682,
   "e": 95.842
  },
  {
   "text": "çok sayıda iç üniteye dağıtılır.",
   "s": 95.842,
   "e": 97.962
  },
  {
   "text": "Her iç ünitenin akışkan miktarı,",
   "s": 97.962,
   "e": 99.862
  },
  {
   "text": "ihtiyacına göre bağımsız ayarlanır.",
   "s": 99.862,
   "e": 102.282
  },
  {
   "text": "Ve sistemde gelişmiş adresleme ile merkezi kontrol",
   "s": 102.282,
   "e": 105.432
  },
  {
   "text": "altyapısı bulunur.",
   "s": 105.432,
   "e": 107.002
  },
  {
   "text": "Isı geri kazanımlı VRF'lerde ise aynı sistemde,",
   "s": 107.002,
   "e": 110.712
  },
  {
   "text": "bir mahal ısıtılırken diğeri eş zamanlı soğutulabilir.",
   "s": 110.712,
   "e": 114.312
  },
  {
   "text": "Buradan çıkan önemli sonuç şu:",
   "s": 115.301,
   "e": 117.331
  },
  {
   "text": "Eşyanın multi split ya da benzeri bir ticari adla",
   "s": 117.331,
   "e": 120.411
  },
  {
   "text": "anılması da, bir dış üniteye birden fazla iç ünite",
   "s": 120.411,
   "e": 123.521
  },
  {
   "text": "bağlanabilmesi de, tarife sınıflandırmasında tek",
   "s": 123.521,
   "e": 126.351
  },
  {
   "text": "başına belirleyici değil.",
   "s": 126.351,
   "e": 127.941
  },
  {
   "text": "Esas alınacak olan, eşyanın fiili teknik yapısı",
   "s": 127.941,
   "e": 130.991
  },
  {
   "text": "ve çalışma prensibi.",
   "s": 130.991,
   "e": 132.682
  },
  {
   "text": "Peki VRF'yi diğer klimalardan nasıl ayıracağız?",
   "s": 133.532,
   "e": 136.872
  },
  {
   "text": "Yazıda dört teknik kriter sayılıyor.",
   "s": 136.872,
   "e": 139.542
  },
  {
   "text": "Bir:",
   "s": 140.38,
   "e": 141.31
  },
  {
   "text": "Her iç ünite ya da bölge için ayrı bir soğutucu",
   "s": 141.31,
   "e": 144.12
  },
  {
   "text": "akışkan ölçme ve kısma elemanı,",
   "s": 144.12,
   "e": 146.24
  },
  {
   "text": "yani Elektronik Genleşme Vanası var mı?",
   "s": 146.24,
   "e": 148.86
  },
  {
   "text": "İki:",
   "s": 149.729,
   "e": 150.669
  },
  {
   "text": "Dış ünite ya da dış ünite grubu,",
   "s": 150.669,
   "e": 153.059
  },
  {
   "text": "aynı ana hat üzerinden birden fazla iç üniteyi",
   "s": 153.059,
   "e": 155.869
  },
  {
   "text": "besleyebiliyor mu?",
   "s": 155.869,
   "e": 157.089
  },
  {
   "text": "Yani ortak bir borulama ağı var mı?",
   "s": 157.089,
   "e": 159.639
  },
  {
   "text": "Üç:",
   "s": 160.485,
   "e": 161.705
  },
  {
   "text": "Kompresör yalnızca aç kapa mantığıyla mı çalışıyor,",
   "s": 161.705,
   "e": 164.615
  },
  {
   "text": "yoksa inverter ya da en az üç kademeli kapasite",
   "s": 164.615,
   "e": 167.725
  },
  {
   "text": "kontrolüyle, kapasiteyi ihtiyaca göre artırıp",
   "s": 167.725,
   "e": 170.435
  },
  {
   "text": "azaltabiliyor mu?",
   "s": 170.435,
   "e": 171.665
  },
  {
   "text": "Dört:",
   "s": 172.503,
   "e": 173.683
  },
  {
   "text": "Dış ünite, iç üniteler ve varsa dağıtım ya da",
   "s": 173.683,
   "e": 176.383
  },
  {
   "text": "mod seçim kutuları arasında veri iletişimi var",
   "s": 176.383,
   "e": 179.203
  },
  {
   "text": "mı;",
   "s": 179.203,
   "e": 179.483
  },
  {
   "text": "iç üniteler sistem tarafından ayrı ayrı tanınabiliyor",
   "s": 179.483,
   "e": 182.463
  },
  {
   "text": "mu?",
   "s": 182.463,
   "e": 182.923
  },
  {
   "text": "Yani, ortak bir haberleşme ve adresleme yapısı.",
   "s": 182.923,
   "e": 186.427
  },
  {
   "text": "Şimdi en kritik kısma geldik.",
   "s": 187.327,
   "e": 189.617
  },
  {
   "text": "Yazıya göre, geçmiş yıllarda düzenlenmiş Bağlayıcı",
   "s": 189.627,
   "e": 192.697
  },
  {
   "text": "Tarife Bilgileri de bu kriterler çerçevesinde",
   "s": 192.697,
   "e": 195.327
  },
  {
   "text": "yeniden değerlendirilecek.",
   "s": 195.327,
   "e": 197.077
  },
  {
   "text": "Gerekli şartları taşımadığı tespit edilen BTB'ler,",
   "s": 197.077,
   "e": 200.017
  },
  {
   "text": "mevzuat hükümleri çerçevesinde iptal edilecek.",
   "s": 200.017,
   "e": 203.309
  },
  {
   "text": "Koçun tavsiyesi:",
   "s": 204.189,
   "e": 205.589
  },
  {
   "text": "Elinizde VRF olarak alınmış bir BTB varsa ya da",
   "s": 205.589,
   "e": 209.399
  },
  {
   "text": "yeni bir ithalat planlıyorsanız,",
   "s": 209.399,
   "e": 211.669
  },
  {
   "text": "ürünün teknik kataloğunu,",
   "s": 211.669,
   "e": 213.139
  },
  {
   "text": "borulama şemasını ve kontrol sistemi dokümanlarını",
   "s": 213.139,
   "e": 216.009
  },
  {
   "text": "şimdiden hazırlayın.",
   "s": 216.009,
   "e": 217.449
  },
  {
   "text": "Dört kriterin her birini belgeyle gösterebilmek,",
   "s": 217.449,
   "e": 220.079
  },
  {
   "text": "olası bir incelemede elinizi güçlendirir.",
   "s": 220.079,
   "e": 222.908
  },
  {
   "text": "Şimdi küçük bir soru:",
   "s": 223.738,
   "e": 225.498
  },
  {
   "text": "Bir dış üniteye beş iç ünite bağlanabiliyor.",
   "s": 225.498,
   "e": 228.598
  },
  {
   "text": "Bu, tek başına VRF demek için yeterli mi?",
   "s": 228.698,
   "e": 232.348
  },
  {
   "text": "Cevap:",
   "s": 234.778,
   "e": 235.858
  },
  {
   "text": "Hayır!",
   "s": 235.858,
   "e": 236.698
  },
  {
   "text": "Bağlanabilen iç ünite sayısı tek başına belirleyici",
   "s": 236.698,
   "e": 239.588
  },
  {
   "text": "değil.",
   "s": 239.588,
   "e": 240.098
  },
  {
   "text": "Dört kritere tek tek bakmak gerekiyor.",
   "s": 240.098,
   "e": 242.716
  },
  {
   "text": "Özetle:",
   "s": 243.526,
   "e": 244.466
  },
  {
   "text": "İsme değil, tekniğe bakın.",
   "s": 244.466,
   "e": 246.236
  },
  {
   "text": "Dört kriter, tek karar.",
   "s": 246.236,
   "e": 248.166
  },
  {
   "text": "Bu ders işinize yaradıysa kanala abone olmayı",
   "s": 248.166,
   "e": 250.806
  },
  {
   "text": "ve videoyu paylaşmayı unutmayın.",
   "s": 250.806,
   "e": 252.686
  },
  {
   "text": "Bir sonraki derste görüşmek üzere,",
   "s": 252.686,
   "e": 254.596
  },
  {
   "text": "hoşça kalın!",
   "s": 254.596,
   "e": 255.602
  }
 ]
}