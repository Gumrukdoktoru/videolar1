 "captions": [
  {
   "text": "Merhaba arkadaşlar, Gümrük Koçu'yla vergi hesaplama",
   "s": 1.68,
   "e": 4.76
  },
  {
   "text": "derslerinin 13'üncüsüne hoş geldiniz.",
   "s": 4.76,
   "e": 7.28
  },
  {
   "text": "Bugünün konusu dampinge karşı vergi.",
   "s": 7.28,
   "e": 9.88
  },
  {
   "text": "Eşya bir ülkeden yüklenmiş ama başka bir ülkenin",
   "s": 9.88,
   "e": 12.8
  },
  {
   "text": "malı.",
   "s": 12.8,
   "e": 13.48
  },
  {
   "text": "Hangi ülkenin önlemi uygulanır,",
   "s": 13.48,
   "e": 15.24
  },
  {
   "text": "hangi ağırlık esas alınır?",
   "s": 15.24,
   "e": 16.84
  },
  {
   "text": "Kâğıt kalem hazırsa, başlayalım.",
   "s": 16.84,
   "e": 19.091
  },
  {
   "text": "Önce soruyu okuyalım.",
   "s": 19.841,
   "e": 21.291
  },
  {
   "text": "D firması, Malezya'dan yüklenen ve menşe şahadetnamesine",
   "s": 21.441,
   "e": 25.361
  },
  {
   "text": "göre Çin menşeli polyester elyaf ithal ediyor.",
   "s": 25.361,
   "e": 28.411
  },
  {
   "text": "CIF kıymet 64.000 dolar.",
   "s": 28.561,
   "e": 31.201
  },
  {
   "text": "Net ağırlık 40.000, brüt ağırlık 41.500 kilogram.",
   "s": 31.201,
   "e": 35.308
  },
  {
   "text": "Gümrük vergisi %4.",
   "s": 35.308,
   "e": 37.361
  },
  {
   "text": "Dampinge karşı vergi;",
   "s": 37.361,
   "e": 38.881
  },
  {
   "text": "Çin menşeli eşya için kilogram başına 0,30 dolar,",
   "s": 38.881,
   "e": 42.801
  },
  {
   "text": "Malezya menşeli eşya için 0,45 dolar.",
   "s": 42.801,
   "e": 46.201
  },
  {
   "text": "Tescilden sonra eşyanın fabrikaya nakli için 2.000",
   "s": 46.201,
   "e": 49.361
  },
  {
   "text": "dolar ödeniyor.",
   "s": 49.361,
   "e": 50.521
  },
  {
   "text": "KDV %20, kur 40 lira.",
   "s": 50.521,
   "e": 53.601
  },
  {
   "text": "Soru şu:",
   "s": 53.601,
   "e": 54.481
  },
  {
   "text": "Ödenecek gümrük vergisi,",
   "s": 54.481,
   "e": 56.161
  },
  {
   "text": "dampinge karşı vergi ve KDV toplamı kaç Türk lirasıdır?",
   "s": 56.161,
   "e": 60.372
  },
  {
   "text": "Şıklarımız şöyle.",
   "s": 61.122,
   "e": 62.562
  },
  {
   "text": "A şıkkı, 1.210.880 lira.",
   "s": 62.562,
   "e": 66.802
  },
  {
   "text": "B şıkkı, 1.226.880 lira.",
   "s": 66.802,
   "e": 71.402
  },
  {
   "text": "C şıkkı, 1.232.480 lira.",
   "s": 71.402,
   "e": 75.842
  },
  {
   "text": "D şıkkı, 1.233.920 lira.",
   "s": 75.842,
   "e": 80.162
  },
  {
   "text": "E şıkkı, 1.498.880 lira.",
   "s": 80.162,
   "e": 84.759
  },
  {
   "text": "Videoyu durdurun ve önce kendiniz çözün.",
   "s": 85.682,
   "e": 88.461
  },
  {
   "text": "Hazırsanız başlayalım.",
   "s": 94.491,
   "e": 96.331
  },
  {
   "text": "Bu sorunun üç anahtarı var.",
   "s": 96.331,
   "e": 98.251
  },
  {
   "text": "Bir:",
   "s": 98.251,
   "e": 98.931
  },
  {
   "text": "Dampinge karşı vergi menşeye göre uygulanır;",
   "s": 98.931,
   "e": 101.771
  },
  {
   "text": "eşyanın yüklendiği ülkeye göre değil.",
   "s": 101.771,
   "e": 104.131
  },
  {
   "text": "İki:",
   "s": 104.131,
   "e": 104.771
  },
  {
   "text": "Kilogram başına verilen tutar,",
   "s": 104.771,
   "e": 106.571
  },
  {
   "text": "aksi belirtilmedikçe net ağırlık üzerinden hesaplanır.",
   "s": 106.571,
   "e": 109.931
  },
  {
   "text": "Üç:",
   "s": 109.931,
   "e": 110.531
  },
  {
   "text": "Dampinge karşı vergi gümrük vergisi matrahına",
   "s": 110.531,
   "e": 113.211
  },
  {
   "text": "girmez, ama KDV matrahına eklenir;",
   "s": 113.211,
   "e": 116.131
  },
  {
   "text": "tescilden sonraki giderler ise KDV matrahına girmez.",
   "s": 116.131,
   "e": 119.895
  },
  {
   "text": "Birinci adım:",
   "s": 120.645,
   "e": 121.685
  },
  {
   "text": "gümrük vergisi.",
   "s": 121.685,
   "e": 122.965
  },
  {
   "text": "64.000 dolar × %4:",
   "s": 122.965,
   "e": 125.605
  },
  {
   "text": "2.560 dolar.",
   "s": 125.605,
   "e": 127.445
  },
  {
   "text": "Dampinge karşı vergiyi bu matraha eklemiyoruz.",
   "s": 127.445,
   "e": 130.613
  },
  {
   "text": "İkinci adım:",
   "s": 131.363,
   "e": 132.443
  },
  {
   "text": "dampinge karşı vergi.",
   "s": 132.443,
   "e": 134.203
  },
  {
   "text": "Eşya Malezya'dan gelse de menşei Çin;",
   "s": 134.203,
   "e": 137.003
  },
  {
   "text": "bu 100'den Çin oranı uygulanır:",
   "s": 137.003,
   "e": 138.883
  },
  {
   "text": "kilogram başına 0,30 dolar.",
   "s": 138.883,
   "e": 141.483
  },
  {
   "text": "Net ağırlık 40.000 kilogram;",
   "s": 141.483,
   "e": 143.203
  },
  {
   "text": "× 0,30, 12.000 dolar.",
   "s": 143.203,
   "e": 146.137
  },
  {
   "text": "Üçüncü adım:",
   "s": 146.887,
   "e": 148.127
  },
  {
   "text": "KDV.",
   "s": 148.127,
   "e": 149.367
  },
  {
   "text": "KDV matrahı;",
   "s": 149.367,
   "e": 150.817
  },
  {
   "text": "64.000, + 2.560, + 12.000:",
   "s": 150.887,
   "e": 155.367
  },
  {
   "text": "78.560 dolar.",
   "s": 155.367,
   "e": 157.567
  },
  {
   "text": "Tescilden sonraki nakliye eklenmez.",
   "s": 157.567,
   "e": 160.007
  },
  {
   "text": "%20'si, 15.712 dolar.",
   "s": 160.007,
   "e": 163.333
  },
  {
   "text": "Ve sonuç:",
   "s": 164.083,
   "e": 165.043
  },
  {
   "text": "2.560 gümrük vergisi, + 12.000 dampinge karşı",
   "s": 165.043,
   "e": 169.163
  },
  {
   "text": "vergi, + 15.712 KDV;",
   "s": 169.163,
   "e": 172.763
  },
  {
   "text": "toplam 30.272 dolar.",
   "s": 172.763,
   "e": 175.323
  },
  {
   "text": "40 liradan, 1.210.880 lira.",
   "s": 175.323,
   "e": 179.203
  },
  {
   "text": "Doğru cevap:",
   "s": 179.203,
   "e": 180.163
  },
  {
   "text": "A şıkkı!",
   "s": 180.163,
   "e": 181.182
  },
  {
   "text": "Şimdi tuzaklara bakalım;",
   "s": 182.092,
   "e": 184.252
  },
  {
   "text": "her yanlış şık, bir hatanın sonucu.",
   "s": 184.252,
   "e": 186.892
  },
  {
   "text": "Tescilden sonraki nakliyeyi KDV matrahına ekleyen,",
   "s": 186.892,
   "e": 190.652
  },
  {
   "text": "B şıkkına, 1.226.880'e çıkar.",
   "s": 190.652,
   "e": 195.052
  },
  {
   "text": "Brüt ağırlığı kullanan,",
   "s": 195.052,
   "e": 196.492
  },
  {
   "text": "C şıkkına, 1.232.480'e gider.",
   "s": 196.492,
   "e": 200.612
  },
  {
   "text": "Dampinge karşı vergiyi gümrük vergisi matrahına",
   "s": 200.612,
   "e": 203.372
  },
  {
   "text": "katan, D şıkkına, 1.233.920'ye ulaşır.",
   "s": 203.372,
   "e": 208.212
  },
  {
   "text": "Yükleme ülkesinin, yani Malezya'nın oranını uygulayan",
   "s": 208.212,
   "e": 211.292
  },
  {
   "text": "ise E şıkkına, 1.498.880'e fırlar.",
   "s": 211.292,
   "e": 216.298
  },
  {
   "text": "Bir uyarı daha:",
   "s": 217.208,
   "e": 218.458
  },
  {
   "text": "Önlemin hangi ülkeye uygulandığını menşe şahadetnamesi",
   "s": 218.488,
   "e": 221.768
  },
  {
   "text": "gösterir.",
   "s": 221.768,
   "e": 222.778
  },
  {
   "text": "Eşya önlem olmayan bir ülkeden yüklenmiş olsa",
   "s": 222.808,
   "e": 225.368
  },
  {
   "text": "bile, menşei önlem konulan ülkeyse vergi alınır.",
   "s": 225.368,
   "e": 228.941
  },
  {
   "text": "Tersi de doğru:",
   "s": 228.941,
   "e": 230.088
  },
  {
   "text": "Önlem yalnızca yükleme ülkesine konulmuşsa ve",
   "s": 230.088,
   "e": 232.808
  },
  {
   "text": "eşyanın menşei başka bir ülkeyse,",
   "s": 232.808,
   "e": 235.048
  },
  {
   "text": "o önlem uygulanmaz.",
   "s": 235.048,
   "e": 236.768
  },
  {
   "text": "Bir de:",
   "s": 236.768,
   "e": 237.421
  },
  {
   "text": "Dampinge karşı vergi kıymetin yüzdesi olarak da,",
   "s": 237.421,
   "e": 240.515
  },
  {
   "text": "kilogram başına bir tutar olarak da konulabilir.",
   "s": 240.515,
   "e": 243.264
  },
  {
   "text": "Koçun notu:",
   "s": 244.094,
   "e": 245.214
  },
  {
   "text": "Dampinge karşı vergide önce menşe şahadetnamesine",
   "s": 245.214,
   "e": 248.414
  },
  {
   "text": "bakın, konşimentoya değil.",
   "s": 248.414,
   "e": 250.254
  },
  {
   "text": "Malın nereden geldiği değil,",
   "s": 250.254,
   "e": 252.014
  },
  {
   "text": "nerede üretildiği önemlidir.",
   "s": 252.014,
   "e": 253.734
  },
  {
   "text": "Kilogram başına tutar net ağırlıkla çarpılır.",
   "s": 253.734,
   "e": 256.534
  },
  {
   "text": "Formülü aklınızda tutun:",
   "s": 256.534,
   "e": 258.054
  },
  {
   "text": "Menşei belirle, gümrük vergisini hesapla,",
   "s": 258.054,
   "e": 260.974
  },
  {
   "text": "dampinge karşı vergiyi net ağırlıkla bul,",
   "s": 260.974,
   "e": 263.614
  },
  {
   "text": "KDV matrahına ekle, KDV'yi hesapla.",
