   "e": 267.095
  },
  {
   "text": "Özetle:",
   "s": 267.845,
   "e": 268.805
  },
  {
   "text": "Gümrük vergisi 2.560, dampinge karşı vergi 12.000,",
   "s": 268.805,
   "e": 273.485
  },
  {
   "text": "KDV 15.712 dolar.",
   "s": 273.485,
   "e": 276.285
  },
  {
   "text": "Toplam, A şıkkı:",
   "s": 276.285,
   "e": 277.925
  },
  {
   "text": "1.210.880 lira.",
   "s": 277.925,
   "e": 281.175
  },
  {
   "text": "Bu ders işinize yaradıysa abone olmayı ve paylaşmayı",
