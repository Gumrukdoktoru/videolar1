 "captions": [
  {
   "text": "Merhaba arkadaşlar, Gümrük Koçu'yla vergi hesaplama",
   "s": 1.66,
   "e": 4.58
  },
  {
   "text": "derslerine hoş geldiniz.",
   "s": 4.58,
   "e": 6.06
  },
  {
   "text": "Bugün sınava hazırlananların en çok karıştırdığı",
   "s": 6.06,
   "e": 8.72
  },
  {
   "text": "konulardan birini, örnek bir soruyla çözüyoruz:",
   "s": 8.72,
   "e": 11.6
  },
  {
   "text": "DVD içinde gelen bir yazılım.",
   "s": 11.6,
   "e": 13.88
  },
  {
   "text": "Kâğıdınızı, kaleminizi hazırlayın;",
   "s": 13.88,
   "e": 15.84
  },
  {
   "text": "birlikte hesaplayalım.",
   "s": 15.84,
   "e": 17.341
  },
  {
   "text": "Önce soruyu okuyalım.",
   "s": 18.141,
   "e": 19.751
  },
  {
   "text": "Türkiye'de yerleşik B şirketi,",
   "s": 19.751,
   "e": 21.891
  },
  {
   "text": "yurt dışından, DVD üzerine kaydedilmiş ve bilgisayarlarda",
   "s": 21.891,
   "e": 25.711
  },
  {
   "text": "kullanılacak bir muhasebe yazılımı ithal ediyor.",
   "s": 25.711,
   "e": 28.501
  },
  {
   "text": "Faturada iki ayrı kalem var:",
   "s": 28.501,
   "e": 30.331
  },
  {
   "text": "Taşıyıcı ortamın, yani DVD'nin kıymeti 50 ABD",
   "s": 30.331,
   "e": 34.341
  },
  {
   "text": "Doları;",
   "s": 34.341,
   "e": 35.081
  },
  {
   "text": "yazılımın kıymeti ise 2.500 ABD Doları.",
   "s": 35.081,
   "e": 38.381
  },
  {
   "text": "Gümrük vergisi oranı %10,",
   "s": 38.381,
   "e": 40.601
  },
  {
   "text": "KDV oranı %20.",
   "s": 40.601,
   "e": 42.101
  },
  {
   "text": "Bizden istenen:",
   "s": 42.101,
   "e": 43.361
  },
  {
   "text": "Ödenmesi gereken gümrük vergisi ve KDV toplamı,",
   "s": 43.361,
   "e": 46.711
  },
  {
   "text": "dolar olarak.",
   "s": 46.711,
   "e": 48.225
  },
  {
   "text": "Şıklarımız şöyle.",
   "s": 49.045,
   "e": 50.975
  },
  {
   "text": "A şıkkı, 16.",
   "s": 50.975,
   "e": 52.035
  },
  {
   "text": "B şıkkı, 511.",
   "s": 52.035,
   "e": 54.355
  },
  {
   "text": "C şıkkı, 516.",
   "s": 54.355,
   "e": 56.645
  },
  {
   "text": "D şıkkı, 765.",
   "s": 56.645,
   "e": 58.605
  },
  {
   "text": "E şıkkı, 816.",
   "s": 58.605,
   "e": 60.875
  },
  {
   "text": "Videoyu durdurun ve önce kendiniz çözün.",
   "s": 60.875,
   "e": 65.005
  },
  {
   "text": "Hazırsanız başlayalım.",
   "s": 71.246,
   "e": 73.106
  },
  {
   "text": "Bu sorunun anahtarı, Gümrük Yönetmeliğinin 54'üncü",
   "s": 73.146,
   "e": 76.676
  },
  {
   "text": "maddesi.",
   "s": 76.676,
   "e": 77.386
  },
  {
   "text": "Bilgisayarda kullanılacak,",
   "s": 77.386,
   "e": 78.866
  },
  {
   "text": "veri ya da komut yüklü taşıyıcılarda,",
   "s": 78.866,
   "e": 81.326
  },
  {
   "text": "gümrük kıymeti olarak sadece taşıyıcı ortamın,",
   "s": 81.326,
   "e": 83.996
  },
  {
   "text": "yani DVD'nin kıymeti esas alınır.",
   "s": 83.996,
   "e": 86.706
  },
  {
   "text": "Yazılımın bedeli, taşıyıcının bedelinden ayrı",
   "s": 86.706,
