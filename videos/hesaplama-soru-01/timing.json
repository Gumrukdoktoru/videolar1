 "captions": [
  {
   "text": "Merhaba arkadaşlar, Gümrük Koçu'yla çıkmış sorular",
   "s": 1.63,
   "e": 4.52
  },
  {
   "text": "serisine hoş geldiniz.",
   "s": 4.52,
   "e": 5.99
  },
  {
   "text": "Bugün geçmiş yılların vergi hesaplama sorularından",
   "s": 5.99,
   "e": 8.96
  },
  {
   "text": "ilkini çözüyoruz.",
   "s": 8.96,
   "e": 10.23
  },
  {
   "text": "Konumuz:",
   "s": 10.23,
   "e": 10.99
  },
  {
   "text": "CD içinde gelen bir yazılım.",
   "s": 10.99,
   "e": 13.23
  },
  {
   "text": "Kâğıdınızı, kaleminizi hazırlayın;",
   "s": 13.23,
   "e": 15.12
  },
  {
   "text": "birlikte hesaplayalım.",
   "s": 15.12,
   "e": 16.609
  },
  {
   "text": "Önce soruyu okuyalım.",
   "s": 17.409,
   "e": 18.969
  },
  {
   "text": "İthalatçı A firması, yurt dışından,",
   "s": 18.969,
   "e": 21.519
  },
  {
   "text": "CD üzerine kaydedilmiş ve bilgisayarlarda kullanılacak",
   "s": 21.519,
   "e": 25.199
  },
  {
   "text": "bir yazılım ithal ediyor.",
   "s": 25.199,
   "e": 26.829
  },
  {
   "text": "Faturada iki kalem var:",
   "s": 26.829,
   "e": 28.389
  },
  {
   "text": "Taşıyıcı ortamın, yani CD'nin kıymeti 10 ABD Doları;",
   "s": 28.389,
   "e": 33.169
  },
  {
   "text": "yazılımın kıymeti ise 1.000 ABD Doları.",
   "s": 33.169,
   "e": 36.069
  },
  {
   "text": "Gümrük vergisi oranı %10,",
   "s": 36.069,
   "e": 38.359
  },
  {
   "text": "KDV oranı %18.",
   "s": 38.359,
   "e": 40.569
  },
  {
   "text": "Bizden istenen:",
   "s": 40.569,
   "e": 41.629
  },
  {
   "text": "Ödenmesi gereken gümrük vergisi ve KDV toplamı,",
   "s": 41.629,
   "e": 45.029
  },
  {
   "text": "dolar olarak.",
   "s": 45.029,
   "e": 46.213
  },
  {
   "text": "Şıklarımız şöyle.",
   "s": 47.023,
   "e": 48.203
  },
  {
   "text": "A şıkkı, 182,98.",
   "s": 48.493,
   "e": 51.603
  },
  {
   "text": "B şıkkı, 181,98.",
   "s": 51.763,
   "e": 54.923
  },
  {
   "text": "C şıkkı, 198,98.",
   "s": 55.133,
   "e": 58.553
  },
  {
   "text": "D şıkkı, 299,98.",
   "s": 58.763,
   "e": 62.343
  },
  {
   "text": "E şıkkı, 282,80.",
   "s": 62.583,
   "e": 65.513
  },
  {
   "text": "Videoyu durdurun ve önce kendiniz çözün.",
   "s": 66.473,
   "e": 69.043
  },
  {
   "text": "Hazırsanız başlayalım.",
   "s": 75.409,
   "e": 77.229
  },
  {
   "text": "Bu sorunun anahtarı, Gümrük Yönetmeliğinin 54'üncü",
   "s": 77.309,
   "e": 80.639
  },
  {
   "text": "maddesi.",
   "s": 80.639,
   "e": 81.429
  },
  {
   "text": "Bilgisayarda kullanılacak,",
   "s": 81.429,
   "e": 82.959
  },
  {
   "text": "veri ya da komut yüklü taşıyıcılarda,",
   "s": 82.959,
   "e": 85.369
  },
  {
   "text": "gümrük kıymeti olarak sadece taşıyıcı ortamın,",
   "s": 85.369,
   "e": 88.129
  },
  {
   "text": "yani CD'nin kıymeti esas alınır.",
   "s": 88.129,
   "e": 90.549
  },
  {
   "text": "Yazılımın bedeli, CD'nin bedelinden ayrı gösterilmişse",
   "s": 90.549,
   "e": 94.029
  },
  {
   "text": "gümrük kıymetine girmez.",
   "s": 94.029,
   "e": 95.729
  },
  {
   "text": "Soruda faturanın iki ayrı kalem olarak verilmesinin",
   "s": 95.729,
   "e": 98.599
  },
  {
   "text": "sebebi tam olarak bu.",
   "s": 98.599,
   "e": 100.225
  },
  {
   "text": "Birinci adım:",
   "s": 101.085,
   "e": 102.155
  },
  {
   "text": "gümrük vergisi.",
   "s": 102.155,
   "e": 103.405
  },
  {
   "text": "Gümrük vergisi matrahı sadece 10 dolar.",
   "s": 103.405,
   "e": 106.205
  },
  {
   "text": "10 doların %10'u, 1 dolar.",
   "s": 106.205,
   "e": 108.625
  },
  {
   "text": "Gümrük vergimiz:",
   "s": 108.625,
   "e": 109.855
  },
  {
   "text": "1 dolar.",
   "s": 109.855,
   "e": 110.864
  },
  {
   "text": "İkinci adım:",
   "s": 111.714,
   "e": 112.494
  },
  {
   "text": "KDV matrahı.",
   "s": 112.494,
   "e": 114.524
  },
  {
   "text": "Burada dikkat!",
