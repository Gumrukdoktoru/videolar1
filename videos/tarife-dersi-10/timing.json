  },
  {
   "text": "Hayır!",
   "s": 193.701,
   "e": 194.501
  },
  {
   "text": "Fasıl notlarındaki ayrım,",
   "s": 194.501,
   "e": 196.101
  },
  {
   "text": "eşyanın nerede kullanıldığıdır:",
   "s": 196.101,
   "e": 198.101
  },
  {
   "text": "Cepte taşınan sigara tabakası mücevherci eşyası,",
   "s": 198.101,
   "e": 201.381
  },
  {
   "text": "masada duran sigara kutusu ve kül tablası ise",
   "s": 201.381,
   "e": 204.101
  },
  {
   "text": "kuyumcu eşyasıdır.",
   "s": 204.101,
   "e": 205.488
  },
  {
   "text": "Bir de dikkat:",
   "s": 205.488,
   "e": 206.621
  },
  {
   "text": "Adi metalden sigara tabakası,",
   "s": 206.621,
   "e": 208.554
  },
  {
   "text": "taklit mücevherci eşyası sayılmaz;",
   "s": 208.554,
   "e": 210.874
  },
  {
   "text": "taklit mücevher yalnız küçük süs eşyasını kapsar.",
   "s": 210.874,
   "e": 214.381
  },
  {
   "text": "Gümrükçü Baba'nın kısa yolu:",
   "s": 214.381,
   "e": 216.181
  },
  {
   "text": "Cepte mi, masada mı?",
   "s": 216.181,
   "e": 217.838
  },
  {
   "text": "Üçüncü soru.",
   "s": 218.588,
   "e": 219.838
  },
  {
   "text": "Bir yolcu limanında, kruvaziyer gemilere biniş",
   "s": 219.868,
   "e": 222.708
  },
  {
   "text": "için kullanılan, teleskopik hareketli bir tünelden",
   "s": 222.708,
   "e": 225.548
  },
  {
   "text": "oluşan yolcu biniş köprüsü hangi tarife pozisyonunda",
   "s": 225.548,
   "e": 228.828
  },
  {
   "text": "sınıflandırılır?",
   "s": 228.828,
   "e": 230.158
  },
  {
   "text": "A şıkkı:",
   "s": 230.188,
   "e": 231.068
  },
  {
   "text": "84.26.",
   "s": 231.068,
   "e": 232.798
  },
  {
   "text": "B şıkkı:",
   "s": 232.828,
   "e": 233.708
  },
  {
   "text": "73.08.",
   "s": 233.708,
   "e": 235.438
  },
  {
   "text": "C şıkkı:",
   "s": 235.468,
   "e": 236.348
  },
  {
   "text": "84.28.",
   "s": 236.348,
   "e": 238.268
  },
  {
   "text": "D şıkkı:",
   "s": 238.268,
   "e": 239.148
  },
  {
   "text": "84.79.",
   "s": 239.148,
   "e": 241.068
  },
  {
   "text": "E şıkkı:",
   "s": 241.068,
   "e": 241.868
  },
  {
   "text": "89.07.",
   "s": 241.868,
   "e": 243.398
  },
  {
   "text": "3 saniye, düşünün!",
   "s": 244.268,
   "e": 246.005
  },
  {
   "text": "Cevap:",
   "s": 250.355,
   "e": 251.235
  },
  {
   "text": "D şıkkı.",
   "s": 251.235,
   "e": 252.125
  },
  {
   "text": "Yolcu biniş köprüsü, yolcuyu bir tünel içinden",
   "s": 252.275,
   "e": 255.235
  },
  {
   "text": "gemiye ya da uçağa ulaştıran,",
   "s": 255.235,
   "e": 256.995
  },
  {
   "text": "hareketli bir makinedir.",
   "s": 256.995,
   "e": 258.445
  },
  {
   "text": "Kendine özgü bir işlevi vardır ve başka bir pozisyonda",
   "s": 258.595,
   "e": 261.555
  },
  {
   "text": "belirtilmemiştir;",
   "s": 261.555,
   "e": 262.715
  },
  {
   "text": "bu yüzden 84.79'da yer alır.",
   "s": 262.715,
   "e": 265.315
  },
  {
   "text": "Armonize Sistem bunlara ayrı alt pozisyonlar da",
   "s": 265.315,
   "e": 268.035
  },
  {
   "text": "açar:",
   "s": 268.035,
   "e": 268.755
  },
  {
   "text": "Havalimanında kullanılanlar 8479.71'de,",
   "s": 268.755,
   "e": 272.445
  },
  {
   "text": "limanda kullanılanlar gibi diğerleri ise 8479.79'dadır.",
   "s": 272.515,
   "e": 277.511
  },
  {
   "text": "Tuzak nerede?",
   "s": 278.341,
   "e": 279.781
  },
  {
   "text": "Yardımcımız, adı köprü diye B şıkkını,",
   "s": 279.781,
   "e": 283.141
  },
  {
   "text": "73.08'i seçti.",
   "s": 283.141,
   "e": 285.061
  },
  {
   "text": "Hayır!",
   "s": 285.061,
   "e": 285.941
  },
  {
   "text": "73.08, sabit çelik köprüler gibi inşaat aksamı",
   "s": 285.941,
   "e": 289.541
  },
  {
   "text": "içindir;",
   "s": 289.541,
   "e": 290.341
  },
  {
   "text": "hareketli, makine niteliğindeki biniş köprüsü",
   "s": 290.341,
   "e": 293.141
  },
  {
   "text": "84.79'dadır.",
   "s": 293.141,
   "e": 295.061
  },
  {
   "text": "Bir de dikkat:",
   "s": 295.061,
   "e": 296.101
  },
  {
   "text": "Yürüyen merdivenler ve yürüyen yollar ise 84.28'dedir.",
   "s": 296.101,
   "e": 300.191
  },
  {
   "text": "Gümrükçü Baba'nın kısa yolu:",
   "s": 300.581,
   "e": 302.341
  },
  {
   "text": "Adına değil, işlevine bakın.",
   "s": 302.341,
   "e": 304.477
  },
  {
   "text": "Koçun notu:",
   "s": 305.307,
   "e": 306.277
  },
  {
   "text": "Bugünün 3 kuralı.",
   "s": 306.427,
   "e": 307.987
  },
  {
   "text": "Bir:",
   "s": 307.987,
   "e": 308.72
  },
  {
   "text": "Hava yastıklı taşıt, en çok benzediği taşıtla",
   "s": 308.72,
   "e": 311.387
  },
  {
   "text": "sınıflandırılır;",
   "s": 311.387,
   "e": 312.467
  },
  {
   "text": "hava treni 86. fasıldadır.",
   "s": 312.467,
   "e": 315.107
  },
  {
   "text": "İki:",
   "s": 315.107,
   "e": 315.814
  },
  {
   "text": "Kıymetli metalden kişisel eşya cepteyse mücevherci,",
   "s": 315.814,
   "e": 319.427
  },
  {
   "text": "masadaysa kuyumcu eşyasıdır.",
   "s": 319.427,
   "e": 321.587
  },
  {
   "text": "Üç:",
   "s": 321.587,
   "e": 322.347
  },
  {
   "text": "Adına değil, işlevine bakın;",
   "s": 322.347,
   "e": 324.147
  },
  {
   "text": "yolcu biniş köprüsü bir makinedir.",
   "s": 324.147,
   "e": 326.558
  },
  {
   "text": "Bugünün cevap anahtarı:",
   "s": 327.308,
   "e": 329.068
  },
  {
   "text": "Birinci soru B, ikinci soru A,",
   "s": 329.068,
   "e": 331.948
  },
  {
   "text": "üçüncü soru D.",
   "s": 331.948,
   "e": 333.308
  },
  {
   "text": "Kaç tanesini bildiniz?",
   "s": 333.308,
   "e": 334.748
  },
  {
   "text": "Yorumlara yazın.",
   "s": 334.748,
   "e": 335.948
  },
  {
   "text": "Böylece tarife derslerinin onuncusunu da tamamladık.",
   "s": 335.948,
   "e": 339.188
  },
  {
   "text": "Bu ders işinize yaradıysa abone olmayı ve paylaşmayı",
   "s": 339.188,
   "e": 342.268
  },
  {
   "text": "unutmayın.",
   "s": 342.268,
   "e": 342.988
  },
  {
   "text": "Bir sonraki derste görüşmek üzere.",
   "s": 342.988,
   "e": 344.788
  },
  {
   "text": "Hoşça kalın!",
   "s": 344.788,
   "e": 345.765
  }
 ]
