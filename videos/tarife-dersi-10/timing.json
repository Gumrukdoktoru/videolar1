   "e": 26.482
  },
  {
   "text": "hangisi doğrudur?",
   "s": 26.482,
   "e": 27.692
  },
  {
   "text": "A şıkkı:",
   "s": 27.922,
   "e": 28.882
  },
  {
   "text": "Hava yastıklı taşıtların tamamı,",
   "s": 28.882,
   "e": 30.962
  },
  {
   "text": "hava taşıtlarıyla birlikte 88. fasılda sınıflandırılır.",
   "s": 30.962,
   "e": 35.212
  },
  {
   "text": "B şıkkı:",
   "s": 35.282,
   "e": 36.242
  },
  {
   "text": "Kılavuz bir hat üzerinde gitmek üzere tasarlanmış",
   "s": 36.242,
   "e": 39.015
  },
  {
   "text": "hava trenleri 86. fasılda sınıflandırılır.",
   "s": 39.015,
   "e": 42.452
  },
  {
   "text": "C şıkkı:",
   "s": 42.482,
   "e": 43.522
  },
  {
   "text": "Hem karada hem suda gidebilen hava yastıklı taşıtlar",
   "s": 43.522,
   "e": 46.802
  },
  {
   "text": "89. fasılda sınıflandırılır.",
