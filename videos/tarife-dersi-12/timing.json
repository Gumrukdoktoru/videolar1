   "e": 241.019
  },
  {
   "text": "Açıklama notuna göre mopetler,",
   "s": 241.169,
   "e": 243.089
  },
  {
   "text": "kaldırımda kullanılan, kendi kendini dengeleyen",
   "s": 243.089,
   "e": 245.649
  },
  {
   "text": "iki tekerlekli elektrikli araçlar ve motosiklet",
   "s": 245.649,
   "e": 248.529
  },
  {
   "text": "sepetleri de bu pozisyondadır.",
   "s": 248.529,
   "e": 250.299
  },
  {
   "text": "Motorsuz, ayakla itilen skuterler ise yetişkinler",
   "s": 250.369,
   "e": 253.449
  },
  {
   "text": "için tasarlanmış olsa bile 95.03'te,",
   "s": 253.449,
   "e": 256.529
  },
  {
   "text": "tekerlekli oyuncaklar arasında sayılır.",
   "s": 256.529,
   "e": 258.965
  },
  {
   "text": "Tuzak nerede?",
   "s": 259.795,
   "e": 261.155
  },
  {
   "text": "Stajyerimiz, bisiklet bisiklettir,",
   "s": 261.155,
   "e": 263.635
  },
  {
   "text": "87.12'dedir diye A şıkkını seçti.",
   "s": 263.635,
   "e": 266.595
  },
  {
   "text": "Hayır!",
   "s": 266.595,
   "e": 267.395
  },
  {
   "text": "87.12 motorsuz bisikletler içindir;",
   "s": 267.395,
   "e": 270.355
  },
  {
   "text": "yardımcı motoru olan bisiklet,",
   "s": 270.355,
   "e": 272.035
  },
  {
   "text": "motoru elektrikli olsa da 87.11'dedir.",
   "s": 272.035,
   "e": 275.315
  },
  {
   "text": "Bir de dikkat:",
   "s": 275.315,
   "e": 276.275
  },
  {
   "text": "Çocuklar için üç tekerlekli bisikletler 95.03'tedir.",
   "s": 276.275,
   "e": 280.405
  },
  {
   "text": "Gümrükçü Baba'nın kısa yolu:",
   "s": 280.435,
   "e": 282.355
  },
  {
   "text": "Motor var mı?",
   "s": 282.355,
   "e": 283.527
  },
  {
   "text": "Koçun notu:",
   "s": 284.357,
   "e": 285.477
  },
  {
   "text": "Bugünün 3 kuralı.",
   "s": 285.477,
   "e": 286.957
  },
  {
   "text": "Bir:",
   "s": 286.957,
   "e": 287.744
  },
  {
   "text": "Biber kuruysa baharattır,",
   "s": 287.744,
   "e": 289.477
  },
  {
   "text": "09.04;",
   "s": 289.477,
   "e": 290.957
  },
  {
   "text": "tazeyse sebzedir.",
   "s": 290.957,
   "e": 292.837
  },
  {
   "text": "İki:",
   "s": 292.837,
   "e": 293.504
  },
  {
   "text": "Güneş paneli tek başına 85.41'dir;",
   "s": 293.504,
   "e": 296.397
  },
  {
   "text": "akü ya da invertörle birleşince jeneratör olur.",
   "s": 296.397,
   "e": 299.637
  },
  {
   "text": "Üç:",
   "s": 299.637,
   "e": 300.317
  },
  {
   "text": "İki tekerlekte motora bakın;",
   "s": 300.317,
   "e": 302.037
  },
  {
   "text": "motorlu bisiklet 87.11,",
   "s": 302.037,
   "e": 304.277
  },
  {
   "text": "motorsuz skuter 95.03.",
   "s": 304.277,
   "e": 306.966
  },
  {
   "text": "Bugünün cevap anahtarı:",
   "s": 307.716,
   "e": 309.396
  },
  {
   "text": "Birinci soru C, ikinci soru D,",
   "s": 309.396,
   "e": 312.196
  },
  {
   "text": "üçüncü soru B.",
   "s": 312.196,
   "e": 313.556
  },
  {
   "text": "Kaç tanesini bildiniz?",
   "s": 313.556,
   "e": 314.916
  },
  {
   "text": "Yorumlara yazın.",
   "s": 314.916,
   "e": 316.036
  },
  {
   "text": "Böylece tarife derslerinin 12'ncisini de tamamladık.",
   "s": 316.036,
   "e": 319.236
  },
  {
   "text": "Bu ders işinize yaradıysa abone olmayı ve paylaşmayı",
   "s": 319.236,
   "e": 322.276
  },
  {
   "text": "unutmayın.",
   "s": 322.276,
   "e": 322.996
  },
  {
   "text": "Bir sonraki derste görüşmek üzere.",
   "s": 322.996,
   "e": 324.836
  },
  {
   "text": "Hoşça kalın!",
   "s": 324.836,
   "e": 325.834
  }
 ]
