   "e": 161.77
  },
  {
   "text": "lira.",
   "s": 161.77,
   "e": 162.45
  },
  {
   "text": "Doğru cevap:",
   "s": 162.45,
   "e": 163.45
  },
  {
   "text": "B şıkkı!",
   "s": 163.45,
   "e": 164.384
  },
  {
   "text": "Şimdi tuzaklara bakalım;",
   "s": 165.374,
   "e": 167.464
  },
  {
   "text": "her yanlış şık, bir hatanın sonucu.",
   "s": 167.694,
   "e": 170.264
  },
  {
   "text": "Navlun ve sigortayı eklemeyip FOB üzerinden hesaplayan,",
   "s": 170.494,
   "e": 174.574
  },
  {
   "text": "A şıkkına, 152.000'e düşer.",
   "s": 174.574,
   "e": 177.214
  },
  {
   "text": "Türkiye'deki tahmil tahliyeyi hurdanın matrahına",
   "s": 177.214,
   "e": 180.014
  },
  {
   "text": "katan, C şıkkına, 174.000'e çıkar.",
   "s": 180.014,
   "e": 183.374
  },
  {
   "text": "Oranları ters uygulayan,",
   "s": 183.374,
   "e": 185.054
  },
  {
   "text": "D şıkkına, 280.000'e gider.",
   "s": 185.054,
   "e": 187.654
  },
  {
   "text": "İkisine de %1 uygulayan ise E şıkkına,",
   "s": 187.654,
   "e": 190.654
  },
  {
   "text": "300.000'e ulaşır.",
   "s": 190.654,
   "e": 192.055
  },
  {
   "text": "Bir uyarı daha:",
   "s": 192.965,
   "e": 194.245
  },
  {
   "text": "Çevre katkı payı her eşyada alınmaz.",
   "s": 194.245,
   "e": 196.805
  },
  {
   "text": "Yalnızca ithaline izin verilen,",
   "s": 196.805,
   "e": 198.725
  },
  {
   "text": "kontrole tabi hurda, atık ve yakıtta alınır;",
   "s": 198.725,
   "e": 201.925
  },
  {
   "text": "yetkili kurum Çevre ve Şehircilik Bakanlığıdır.",
   "s": 201.925,
   "e": 204.805
  },
  {
   "text": "Bir de:",
   "s": 204.805,
   "e": 205.605
  },
  {
   "text": "Oran ‰5 ya da %1;",
   "s": 205.605,
   "e": 207.685
  },
  {
   "text": "ama matrah her zaman CIF bedeldir,",
   "s": 207.685,
   "e": 210.485
  },
  {
   "text": "FOB değil.",
   "s": 210.485,
   "e": 211.889
  },
  {
   "text": "Koçun notu:",
   "s": 212.719,
   "e": 213.839
  },
  {
   "text": "Çevre katkı payında iki soru sorun.",
   "s": 213.839,
   "e": 216.199
  },
  {
   "text": "Eşya hurda mı?",
   "s": 216.199,
   "e": 217.439
  },
  {
   "text": "‰5.",
   "s": 217.439,
   "e": 218.452
  },
  {
   "text": "Yakıt ya da atık mı?",
   "s": 218.452,
   "e": 219.799
  },
  {
   "text": "%1.",
   "s": 219.799,
   "e": 220.799
  },
  {
   "text": "Sonra matrahı CIF'e tamamlayın:",
   "s": 220.799,
   "e": 223.559
  },
  {
   "text": "FOB ise navlun ve sigortayı ekleyin.",
   "s": 223.559,
   "e": 226.599
  },
  {
   "text": "Formülü aklınızda tutun:",
   "s": 226.599,
   "e": 228.039
  },
  {
   "text": "Kalemleri ayır, CIF bedeli bul,",
   "s": 228.039,
   "e": 230.799
  },
  {
   "text": "oranı seç, kalemleri topla,",
   "s": 230.799,
   "e": 232.759
  },
  {
   "text": "kurla çarp.",
   "s": 232.759,
   "e": 233.891
  },
  {
   "text": "Özetle:",
   "s": 234.641,
   "e": 235.601
  },
  {
   "text": "Hurda için ‰5'le 3.250 dolar,",
   "s": 235.601,
   "e": 238.801
  },
  {
   "text": "petrol koku için %1'le 1.000 dolar.",
   "s": 238.801,
   "e": 241.681
  },
  {
   "text": "Toplam çevre katkı payı,",
   "s": 241.681,
   "e": 243.361
  },
  {
   "text": "B şıkkı:",
   "s": 243.361,
   "e": 244.321
  },
  {
   "text": "170.000 lira.",
   "s": 244.321,
   "e": 245.891
  },
  {
   "text": "Bu ders işinize yaradıysa abone olmayı ve paylaşmayı",
   "s": 245.921,
   "e": 249.001
  },
  {
   "text": "unutmayın.",
   "s": 249.001,
   "e": 249.761
  },
  {
   "text": "Bir sonraki hesaplama dersinde görüşmek üzere,",
   "s": 249.761,
   "e": 252.161
  },
  {
   "text": "hoşça kalın!",
   "s": 252.161,
   "e": 253.098
  }
 ]
