   "text": "Hurdada ‰5, yakıt ve atıkta %1.",
   "s": 9.6,
   "e": 12.84
  },
  {
   "text": "Matrah ise CIF bedel.",
   "s": 12.84,
   "e": 14.88
  },
  {
   "text": "Oranları karıştırırsanız sonuç değişir.",
   "s": 14.88,
   "e": 17.32
  },
  {
   "text": "Kâğıt kalem hazırsa, başlayalım.",
   "s": 17.32,
   "e": 19.561
  },
  {
   "text": "Önce soruyu okuyalım.",
   "s": 20.311,
   "e": 21.911
  },
  {
   "text": "Ç firması, Amerika'dan FOB teslim şekliyle,",
   "s": 21.911,
   "e": 25.751
  },
  {
   "text": "aynı beyannamede iki kalem eşya ithal ediyor.",
   "s": 25.751,
   "e": 28.791
  },
  {
   "text": "Birinci kalem, kontrole tabi demir çelik hurdası:",
   "s": 28.791,
   "e": 31.991
  },
  {
   "text": "FOB 600.000 dolar, navlun 45.000,",
   "s": 31.991,
   "e": 35.391
  },
  {
   "text": "sigorta 5.000 dolar;",
   "s": 35.391,
   "e": 36.951
  },
  {
   "text": "ayrıca Türkiye'deki boşaltma limanında 20.000",
   "s": 36.951,
   "e": 39.671
  },
  {
   "text": "dolar tahmil tahliye ödeniyor.",
   "s": 39.671,
   "e": 41.751
  },
  {
   "text": "İkinci kalem, kontrole tabi yakıt,",
   "s": 41.751,
   "e": 44.071
  },
  {
   "text": "petrol koku:",
   "s": 44.071,
   "e": 45.191
  },
  {
   "text": "FOB 80.000, navlun 18.000,",
   "s": 45.191,
   "e": 48.271
  },
  {
   "text": "sigorta 2.000 dolar.",
   "s": 48.271,
   "e": 49.751
  },
  {
   "text": "Kur 40 lira.",
   "s": 49.751,
   "e": 50.881
  },
  {
   "text": "Soru şu:",
   "s": 51.031,
   "e": 51.911
  },
  {
   "text": "Ödenecek çevre katkı payı toplamı kaç Türk lirasıdır?",
   "s": 51.911,
   "e": 55.33
  },
  {
   "text": "Şıklarımız şöyle.",
   "s": 56.08,
   "e": 57.52
  },
  {
   "text": "A şıkkı, 152.000 lira.",
   "s": 57.52,
   "e": 60.08
  },
  {
   "text": "B şıkkı, 170.000 lira.",
   "s": 60.08,
   "e": 62.6
  },
  {
   "text": "C şıkkı, 174.000 lira.",
   "s": 62.6,
   "e": 65.2
  },
  {
   "text": "D şıkkı, 280.000 lira.",
   "s": 65.2,
   "e": 67.84
  },
  {
   "text": "E şıkkı, 300.000 lira.",
   "s": 67.84,
   "e": 70.25
  },
  {
   "text": "Videoyu durdurun ve önce kendiniz çözün.",
   "s": 70.754,
   "e": 73.414
  },
  {
   "text": "Hazırsanız başlayalım.",
   "s": 79.444,
   "e": 81.414
  },
  {
   "text": "Bu sorunun üç anahtarı var.",
   "s": 81.444,
   "e": 83.294
  },
  {
   "text": "Bir:",
   "s": 83.364,
   "e": 84.084
  },
  {
   "text": "Hurdalarda çevre katkı payı,",
   "s": 84.084,
   "e": 86.004
  },
  {
   "text": "CIF bedelin ‰5'idir.",
   "s": 86.004,
   "e": 88.324
  },
  {
   "text": "İki:",
   "s": 88.324,
   "e": 89.004
  },
  {
   "text": "Kontrole tabi yakıt ve atıklarda oran,",
   "s": 89.004,
   "e": 91.444
  },
  {
   "text": "CIF bedelin %1'idir.",
   "s": 91.444,
   "e": 93.804
  },
  {
   "text": "Üç:",
   "s": 93.804,
   "e": 94.524
  },
  {
   "text": "Matrah CIF bedeldir;",
   "s": 94.524,
   "e": 96.484
  },
  {
   "text": "FOB teslimde navlun ve sigorta eklenir,",
   "s": 96.484,
   "e": 99.364
  },
  {
   "text": "Türkiye'deki liman giderleri eklenmez.",
   "s": 99.364,
   "e": 101.661
  },
  {
   "text": "Birinci adım:",
   "s": 102.411,
   "e": 103.611
  },
  {
   "text": "CIF bedeller.",
   "s": 103.611,
   "e": 105.371
  },
  {
   "text": "Hurda:",
   "s": 105.371,
   "e": 106.291
  },
  {
   "text": "600.000, + 45.000, + 5.000;",
   "s": 106.291,
   "e": 109.731
  },
  {
   "text": "650.000 dolar.",
   "s": 109.731,
   "e": 111.061
  },
  {
   "text": "Türkiye'deki tahmil tahliye bu toplama girmez.",
   "s": 111.131,
   "e": 114.171
  },
  {
   "text": "Petrol koku:",
   "s": 114.171,
   "e": 115.371
  },
  {
   "text": "80.000, + 18.000, + 2.000;",
   "s": 115.371,
   "e": 118.651
  },
  {
   "text": "100.000 dolar.",
   "s": 118.651,
   "e": 119.823
  },
  {
   "text": "İkinci adım:",
   "s": 120.573,
   "e": 121.613
  },
  {
   "text": "hurda.",
   "s": 121.613,
   "e": 122.493
  },
  {
   "text": "650.000 dolar × ‰5:",
   "s": 122.493,
   "e": 125.173
  },
  {
   "text": "3.250 dolar.",
   "s": 125.173,
   "e": 126.973
  },
  {
   "text": "‰5, %0,5 demektir;",
   "s": 126.973,
   "e": 129.773
  },
  {
   "text": "%5'le karıştırmayın.",
   "s": 129.773,
   "e": 131.429
  },
  {
   "text": "Üçüncü adım:",
   "s": 132.179,
   "e": 133.339
  },
  {
   "text": "petrol koku.",
   "s": 133.339,
   "e": 134.419
  },
  {
   "text": "Kontrole tabi yakıt olduğu için oran %1:",
   "s": 134.419,
   "e": 137.739
  },
  {
   "text": "100.000 dolar × %1, 1.000 dolar.",
   "s": 137.739,
   "e": 140.619
  },
  {
   "text": "İki kalemin toplamı:",
   "s": 140.619,
   "e": 142.099
  },
  {
   "text": "3.250 + 1.000, 4.250 dolar.",
   "s": 142.099,
   "e": 145.779
  },
  {
   "text": "Kur 40'la çarpınca:",
   "s": 145.779,
   "e": 147.419
  },
  {
   "text": "170.000 lira.",
   "s": 147.419,
   "e": 148.86
  },
  {
   "text": "Ve sonuç:",
   "s": 149.61,
   "e": 150.58
  },
  {
   "text": "hurdada ‰5'le 3.250 dolar,",
   "s": 150.65,
   "e": 153.81
  },
  {
   "text": "petrol kokunda %1'le 1.000 dolar;",
   "s": 153.81,
   "e": 156.45
  },
  {
   "text": "toplam 4.250 dolar.",
   "s": 156.45,
   "e": 158.53
  },
  {
   "text": "40 liradan, ödenecek çevre katkı payı 170.000",
