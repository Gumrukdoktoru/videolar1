 "captions": [
  {
   "text": "Merhaba arkadaşlar, Gümrük Koçu'yla tarife derslerinin",
   "s": 1.69,
   "e": 4.92
  },
  {
   "text": "ilkine hoş geldiniz.",
   "s": 4.92,
   "e": 6.3
  },
  {
   "text": "Bugün tarife cetvelinin sistematiğinden 3 soru",
   "s": 6.3,
   "e": 9.04
  },
  {
   "text": "çözeceğiz:",
   "s": 9.04,
   "e": 9.98
  },
  {
   "text": "bölüm ve fasıllar, Armonize Sistem ve ölçü birimleri.",
   "s": 9.98,
   "e": 13.73
  },
  {
   "text": "Ekip de hazır:",
   "s": 13.73,
   "e": 14.89
  },
  {
   "text": "Stajyer, Yardımcı, Gümrükçü Baba ve Cano.",
   "s": 14.89,
   "e": 18.17
  },
  {
   "text": "Kâğıt kalem hazırsa, başlayalım.",
   "s": 18.17,
   "e": 20.33
  },
  {
   "text": "Birinci soru.",
   "s": 21.241,
   "e": 22.331
  },
  {
   "text": "Adi metaller ve adi metallerden eşya,",
   "s": 22.331,
   "e": 25.371
  },
  {
   "text": "Türk Gümrük Tarife Cetvelinin hangi bölüm ve fasıllarında",
   "s": 25.371,
   "e": 28.571
  },
  {
   "text": "yer almaktadır?",
   "s": 28.571,
   "e": 29.711
  },
  {
   "text": "A şıkkı:",
   "s": 29.711,
   "e": 30.731
  },
  {
   "text": "14. bölüm, 71. fasıl.",
   "s": 30.731,
   "e": 33.311
  },
  {
   "text": "B şıkkı:",
   "s": 33.311,
   "e": 34.331
  },
  {
   "text": "16. bölüm, 84 ve 85. fasıllar.",
   "s": 34.331,
   "e": 37.911
  },
  {
   "text": "C şıkkı:",
   "s": 37.911,
   "e": 38.931
  },
  {
   "text": "15. bölüm, 72 ile 83 arası fasıllar.",
   "s": 38.931,
   "e": 42.611
  },
  {
   "text": "D şıkkı:",
   "s": 42.611,
   "e": 43.631
  },
  {
   "text": "13. bölüm, 68 ile 70 arası fasıllar.",
   "s": 43.631,
   "e": 47.211
  },
  {
   "text": "E şıkkı:",
   "s": 47.211,
   "e": 48.221
  },
  {
   "text": "17. bölüm, 86 ile 89 arası fasıllar.",
   "s": 48.221,
   "e": 52.641
  },
  {
   "text": "3 saniye, düşünün!",
   "s": 52.641,
   "e": 54.52
  },
  {
   "text": "Cevap:",
   "s": 58.95,
   "e": 59.19
  },
  {
   "text": "C şıkkı.",
   "s": 59.19,
   "e": 60.75
  },
  {
   "text": "Adi metaller, 15. bölümde,",
   "s": 60.75,
   "e": 63.07
  },
  {
   "text": "72 ile 83 arası fasıllarda yer alır.",
   "s": 63.07,
   "e": 66.15
  },
  {
   "text": "Bölüm demir ve çelikle başlar;",
   "s": 66.15,
   "e": 68.45
  },
  {
   "text": "bakır, nikel, alüminyum,",
   "s": 68.45,
   "e": 70.48
  },
  {
   "text": "kurşun, çinko, kalay ve diğer adi metallerle devam",
   "s": 70.48,
   "e": 74.1
  },
  {
   "text": "eder;",
   "s": 74.1,
   "e": 74.55
  },
  {
   "text": "adi metallerden aletler ve çeşitli eşyayla biter.",
   "s": 74.55,
   "e": 78.19
  },
  {
   "text": "Dikkat!",
   "s": 78.19,
   "e": 78.99
  },
  {
   "text": "77. fasıl boştur;",
   "s": 78.99,
   "e": 80.91
  },
  {
   "text": "Armonize Sistemde ileride kullanılmak üzere saklı",
   "s": 80.91,
   "e": 83.72
  },
  {
   "text": "tutulmuştur.",
   "s": 83.72,
   "e": 84.746
  },
  {
   "text": "Peki tuzak nerede?",
   "s": 85.586,
   "e": 87.476
  },
  {
   "text": "Yardımcımız, metalden yapılmış diye makineleri",
   "s": 87.566,
   "e": 90.366
  },
  {
   "text": "seçti:",
   "s": 90.366,
   "e": 90.886
  },
  {
   "text": "B şıkkı.",
   "s": 90.886,
   "e": 91.786
  },
  {
   "text": "Ama 84 ve 85. fasıllar makinelerin yeridir.",
   "s": 91.786,
   "e": 95.586
  },
  {
   "text": "1 ile 83 arası fasıllarda eşya genel olarak yapıldığı",
   "s": 95.586,
   "e": 99.376
  },
  {
   "text": "maddeye göre, 84 ile 96 arasında ise işlevine",
   "s": 99.376,
   "e": 102.576
  },
  {
   "text": "göre sınıflandırılır.",
   "s": 102.576,
   "e": 104.156
  },
  {
   "text": "A şıkkındaki 71. fasıl da kıymetli metallerin",
   "s": 104.156,
   "e": 107.186
  },
  {
   "text": "yeridir:",
   "s": 107.186,
   "e": 107.986
  },
  {
   "text": "altın, gümüş, platin.",
   "s": 107.986,
   "e": 109.786
  },
  {
   "text": "Kıymetli metal ayrı, adi metal ayrı!",
   "s": 109.786,
   "e": 112.835
  },
  {
   "text": "İkinci soru.",
   "s": 113.615,
   "e": 114.815
  },
  {
   "text": "Armonize Sistem ve tarife cetvelinin sınıflandırma",
   "s": 114.815,
   "e": 117.775
  },
  {
   "text": "mantığı ile ilgili aşağıdaki ifadelerden hangisi",
   "s": 117.775,
   "e": 120.875
  },
  {
   "text": "yanlıştır?",
   "s": 120.875,
   "e": 121.915
  },
  {
   "text": "A şıkkı:",
   "s": 121.915,
   "e": 123.145
  },
  {
   "text": "Armonize Sistem, merkezi Brüksel'de bulunan Dünya",
   "s": 123.145,
   "e": 125.845
  },
  {
   "text": "Gümrük Örgütü bünyesinde hazırlanmıştır.",
   "s": 125.845,
   "e": 128.615
  },
  {
   "text": "B şıkkı:",
   "s": 128.615,
   "e": 129.805
  },
  {
   "text": "Kodun ilk 6 hanesi, sisteme taraf tüm ülkelerde",
   "s": 129.805,
   "e": 132.865
  },
  {
   "text": "aynı şekilde uygulanır.",
   "s": 132.865,
   "e": 134.835
  },
  {
   "text": "C şıkkı:",
   "s": 134.835,
   "e": 136.035
  },
  {
   "text": "Sınıflandırma genel olarak canlıdan cansıza,",
   "s": 136.035,
   "e": 138.775
  },
  {
   "text": "ham maddeden mamul eşyaya doğru bir sıra izler.",
   "s": 138.775,
   "e": 141.558
  },
  {
   "text": "D şıkkı:",
   "s": 141.558,
   "e": 142.162
  },
  {
   "text": "84 ile 96 arası fasıllardaki eşya,",
   "s": 142.162,
   "e": 145.615
  },
  {
   "text": "genel olarak işlevine göre sınıflandırılır.",
   "s": 145.615,
   "e": 149.095
  },
  {
   "text": "E şıkkı:",
   "s": 149.095,
   "e": 149.655
  },
  {
   "text": "İlk bakışta iki pozisyona girebilen eşya,",
   "s": 149.655,
   "e": 152.655
  },
  {
   "text": "vergi oranı yüksek olan pozisyonda sınıflandırılır.",
   "s": 152.655,
   "e": 156.415
  },
  {
   "text": "3 saniye, düşünün!",
   "s": 156.415,
   "e": 158.348
  },
  {
   "text": "Cevap:",
   "s": 162.738,
   "e": 163.698
  },
  {
   "text": "E şıkkı.",
   "s": 163.698,
   "e": 164.698
  },
  {
   "text": "Tarifede vergi oranına göre sınıflandırma yoktur!",
   "s": 164.698,
   "e": 167.828
  },
  {
   "text": "Eşya ilk bakışta iki pozisyona girebiliyorsa,",
   "s": 167.828,
   "e": 170.798
  },
  {
   "text": "3. genel kural sırayla uygulanır.",
   "s": 170.798,
   "e": 173.478
  },
  {
   "text": "Önce, eşyayı en özel şekilde tanımlayan pozisyon.",
   "s": 173.478,
   "e": 177.048
  },
  {
   "text": "Bu yetmezse, eşyaya esas niteliğini veren madde",
   "s": 177.048,
   "e": 180.158
  },
  {
   "text": "veya parça.",
   "s": 180.158,
   "e": 181.198
  },
  {
   "text": "O da sonuç vermezse, numara sırasına göre en son",
   "s": 181.198,
   "e": 184.078
  },
  {
   "text": "gelen pozisyon.",
   "s": 184.078,
   "e": 185.468
  },
  {
   "text": "Diğer 4 ifade doğrudur.",
   "s": 185.468,
   "e": 187.477
  },
  {
   "text": "Bu soruda gizli bir tuzak daha var.",
   "s": 188.317,
   "e": 190.987
  },
  {
   "text": "Cano'ya Armonize Sistemi kimin hazırladığını sorduk;",
   "s": 191.017,
   "e": 194.277
  },
  {
   "text": "Dünya Ticaret Örgütü dedi.",
   "s": 194.277,
   "e": 196.117
  },
  {
   "text": "Hayır!",
   "s": 196.117,
   "e": 196.857
  },
  {
   "text": "Armonize Sistem, Dünya Gümrük Örgütü'nün eseridir.",
   "s": 196.857,
   "e": 200.037
  },
  {
   "text": "Gümrükçü Baba'nın formülü:",
   "s": 200.037,
   "e": 201.737
  },
  {
   "text": "DGÖ gümrük, DTÖ ticaret.",
   "s": 201.737,
   "e": 204.757
  },
  {
   "text": "Bir de kod yapısı:",
   "s": 204.757,
   "e": 206.037
  },
  {
   "text": "12 haneli tarife kodunun ilk 6 hanesi Armonize",
   "s": 206.037,
   "e": 209.447
  },
  {
   "text": "Sistem;",
   "s": 209.447,
   "e": 209.997
  },
  {
   "text": "7 ve 8. haneler Avrupa Birliği Kombine Nomanklatürü;",
   "s": 209.997,
   "e": 213.837
  },
  {
   "text": "9 ve 10. haneler milli alt açılım;",
   "s": 213.837,
   "e": 216.677
  },
  {
   "text": "son 2 hane ise istatistik kodudur.",
   "s": 216.677,
   "e": 219.406
  },
  {
   "text": "Üçüncü soru.",
   "s": 220.156,
   "e": 221.406
  },
  {
   "text": "Türk Gümrük Tarife Cetvelinde kullanılan ölçü",
   "s": 221.436,
   "e": 224.076
  },
  {
   "text": "birimi kısaltmaları ile anlamlarına ilişkin aşağıdaki",
   "s": 224.076,
   "e": 227.036
  },
  {
   "text": "eşleştirmelerden hangisi yanlıştır?",
   "s": 227.036,
   "e": 229.806
  },
  {
   "text": "A şıkkı:",
   "s": 229.836,
   "e": 230.876
  },
  {
   "text": "ct/l, karat.",
   "s": 230.876,
   "e": 233.356
  },
  {
   "text": "B şıkkı:",
   "s": 233.356,
   "e": 234.316
  },
  {
   "text": "p/st, adet.",
   "s": 234.316,
   "e": 236.636
  },
  {
   "text": "C şıkkı:",
   "s": 236.636,
   "e": 237.526
  },
  {
   "text": "ce/el, hücre adedi.",
   "s": 237.676,
   "e": 240.716
  },
  {
   "text": "D şıkkı:",
   "s": 240.716,
   "e": 241.526
  },
  {
   "text": "p/a, çift.",
   "s": 241.596,
   "e": 243.676
  },
  {
   "text": "E şıkkı:",
   "s": 243.676,
   "e": 244.566
  },
  {
   "text": "TJ, terajul.",
   "s": 244.716,
   "e": 246.266
  },
  {
   "text": "3 saniye, düşünün!",
   "s": 246.756,
   "e": 248.514
  },
  {
   "text": "Cevap:",
   "s": 252.934,
   "e": 253.624
  },
  {
   "text": "A şıkkı.",
   "s": 253.684,
   "e": 254.654
  },
  {
   "text": "Karatın kısaltması c/k.",
   "s": 254.654,
   "e": 257.031
  },
  {
   "text": "ct/l ise, ton başına taşıma kapasitesini gösterir.",
   "s": 257.031,
   "e": 261.434
  },
  {
   "text": "Diğer eşleştirmeler doğru:",
   "s": 261.434,
   "e": 263.234
  },
  {
   "text": "p/st adet, ce/el hücre adedi,",
   "s": 263.234,
   "e": 267.134
  },
  {
   "text": "p/a çift;",
   "s": 267.134,
   "e": 269.114
  },
  {
   "text": "TJ ise brüt kalori değeri olarak terajul.",
   "s": 269.134,
   "e": 272.434
  },
  {
   "text": "Bir de not:",
   "s": 272.434,
   "e": 273.434
  },
  {
   "text": "Bir karat, 0,2 gramdır.",
   "s": 273.434,
   "e": 276.274
  },
  {
   "text": "Tuzak, birbirine benzeyen kısaltmalarda.",
   "s": 277.115,
   "e": 280.375
  },
  {
   "text": "Stajyerimiz p/a'yı görünce adet sandı.",
   "s": 280.375,
   "e": 283.565
  },
  {
   "text": "Hayır!",
   "s": 283.735,
   "e": 284.595
  },
  {
   "text": "p/a, çift demektir;",
   "s": 284.595,
   "e": 286.355
  },
  {
   "text": "ayakkabı ya da eldiven gibi.",
   "s": 286.355,
   "e": 288.085
  },
  {
   "text": "Adet ise p/st.",
   "s": 288.085,
   "e": 290.265
  },
  {
   "text": "Aynı şekilde c/k karat,",
   "s": 290.265,
   "e": 292.395
  },
  {
   "text": "ct/l taşıma kapasitesi.",
   "s": 292.395,
   "e": 295.015
  },
  {
   "text": "Harfler benzer, anlamlar farklı!",
   "s": 295.015,
   "e": 297.556
  },
  {
   "text": "Koçun notu:",
   "s": 298.396,
   "e": 299.436
  },
  {
   "text": "Tarife sorularını ezberle değil,",
   "s": 299.436,
   "e": 301.366
  },
  {
   "text": "mantıkla çözün.",
   "s": 301.366,
   "e": 302.756
  },
  {
   "text": "Bir:",
   "s": 302.756,
   "e": 303.636
  },
  {
   "text": "Bölümler ham maddeden mamule doğru sıralanır;",
   "s": 303.636,
   "e": 306.376
  },
  {
   "text": "metaller önce madde olarak gelir,",
   "s": 306.376,
   "e": 308.636
  },
  {
   "text": "makineler ise işlevine göre.",
   "s": 308.636,
   "e": 310.536
  },
  {
   "text": "İki:",
   "s": 310.536,
   "e": 310.906
  },
  {
   "text": "Sınıflandırmada vergi oranı asla ölçüt değildir;",
   "s": 310.906,
   "e": 314.476
  },
  {
   "text": "genel kurallar sırayla uygulanır.",
   "s": 314.476,
   "e": 316.806
  },
  {
   "text": "Üç:",
   "s": 316.806,
   "e": 317.176
  },
  {
   "text": "Kısaltmaları çift çift öğrenin:",
   "s": 317.176,
   "e": 319.526
  },
  {
   "text": "karat ile taşıma kapasitesi,",
   "s": 319.526,
   "e": 321.576
  },
  {
   "text": "çift ile adet.",
   "s": 321.576,
   "e": 322.902
  },
  {
   "text": "Bugünün cevap anahtarı:",
   "s": 323.732,
   "e": 325.252
  },
  {
   "text": "Birinci soru C, ikinci soru E,",
   "s": 325.252,
   "e": 328.272
  },
  {
   "text": "üçüncü soru A.",
   "s": 328.272,
   "e": 329.682
  },
  {
   "text": "Kaç tanesini bildiniz?",
   "s": 329.682,
   "e": 331.102
  },
  {
   "text": "Yorumlara yazın.",
   "s": 331.102,
   "e": 332.122
  },
  {
   "text": "Bu ders işinize yaradıysa abone olmayı ve paylaşmayı",
   "s": 332.122,
   "e": 335.262
  },
  {
   "text": "unutmayın.",
   "s": 335.262,
   "e": 335.892
  },
  {
   "text": "Bir sonraki tarife dersinde,",
   "s": 335.892,
   "e": 337.582
  },
  {
   "text": "yeni 3 soruyla görüşmek üzere.",
   "s": 337.582,
   "e": 339.572
  },
  {
   "text": "Hoşça kalın!",
   "s": 339.572,
   "e": 340.673
  }
