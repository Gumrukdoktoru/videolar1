  {
   "text": "D şıkkı.",
   "s": 138.315,
   "e": 139.205
  },
  {
   "text": "Altmış altıncı faslın birinci notu,",
   "s": 139.355,
   "e": 141.595
  },
  {
   "text": "tüfekli, kılıçlı ve kurşunlu bastonları açıkça",
   "s": 141.595,
   "e": 144.915
  },
  {
   "text": "fasıl dışında bırakır ve 93. fasla gönderir.",
   "s": 144.915,
   "e": 148.235
  },
  {
   "text": "Bu baston, içindeki kurşun ağırlık sayesinde bir",
