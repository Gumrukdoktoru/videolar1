 "captions": [
  {
   "text": "Merhaba arkadaşlar, Gümrük Koçu'yla tarife derslerinin",
   "s": 1.68,
   "e": 4.88
  },
  {
   "text": "dokuzuncusuna hoş geldiniz.",
   "s": 4.88,
   "e": 6.72
  },
  {
   "text": "Bugün yine 3 soru var:",
   "s": 6.72,
   "e": 8.2
  },
  {
   "text": "özel amaçlı taşıtlar, silahlı bastonlar ve kauçuk",
   "s": 8.2,
   "e": 11.44
  },
  {
   "text": "contalar.",
   "s": 11.44,
   "e": 12.28
  },
  {
   "text": "Ekip hazır:",
   "s": 12.28,
   "e": 13.28
  },
  {
   "text": "Stajyer, Yardımcı, Gümrükçü Baba ve Cano.",
   "s": 13.28,
   "e": 16.6
  },
  {
   "text": "Kâğıt kalem hazırsa, başlayalım.",
   "s": 16.6,
   "e": 18.777
  },
  {
   "text": "Birinci soru.",
   "s": 19.527,
   "e": 20.727
  },
  {
   "text": "Aşağıdaki taşıt çiftlerinden hangisinde,",
   "s": 20.727,
   "e": 23.367
  },
  {
   "text": "iki taşıt farklı tarife pozisyonlarında sınıflandırılır?",
   "s": 23.367,
   "e": 27.017
  },
  {
   "text": "A şıkkı:",
   "s": 27.047,
   "e": 28.007
  },
  {
   "text": "Ambulans ve itfaiye aracı.",
   "s": 28.007,
   "e": 30.167
  },
  {
   "text": "B şıkkı:",
   "s": 30.167,
   "e": 31.057
  },
  {
   "text": "Cenaze arabası ve taksi.",
   "s": 31.127,
   "e": 33.057
  },
  {
   "text": "C şıkkı:",
   "s": 33.287,
   "e": 34.327
  },
  {
   "text": "Golf arabası ve motorlu karavan.",
   "s": 34.327,
   "e": 36.727
  },
  {
   "text": "D şıkkı:",
   "s": 36.727,
   "e": 37.687
  },
  {
   "text": "Beton mikser kamyonu ve vinçli kurtarıcı.",
   "s": 37.687,
   "e": 40.727
  },
  {
   "text": "E şıkkı:",
   "s": 40.727,
   "e": 41.617
  },
  {
   "text": "Hapishane minibüsü ve binek otomobili.",
   "s": 41.687,
   "e": 44.284
  },
  {
   "text": "3 saniye, düşünün!",
   "s": 44.647,
   "e": 46.526
  },
  {
   "text": "Cevap:",
   "s": 50.876,
   "e": 51.676
  },
  {
   "text": "A şıkkı.",
   "s": 51.676,
   "e": 52.566
  },
  {
   "text": "Ambulans hastaları taşır;",
   "s": 52.636,
   "e": 54.516
  },
  {
   "text": "insan taşımaya mahsus taşıt olarak 87.03'tedir.",
   "s": 54.516,
   "e": 58.196
  },
  {
   "text": "İtfaiye aracı ise insan ya da eşya taşımak için",
   "s": 58.196,
   "e": 61.116
  },
  {
   "text": "değil, yangın söndürme hizmeti için donatılmıştır;",
   "s": 61.116,
   "e": 64.116
  },
  {
   "text": "özel amaçlı taşıt olarak 87.05'e gider.",
   "s": 64.116,
   "e": 67.596
  },
  {
   "text": "Diğer çiftlerde iki taşıt da aynı pozisyondadır:",
   "s": 67.596,
   "e": 70.756
  },
  {
   "text": "Cenaze arabası, taksi, golf arabası,",
   "s": 70.756,
   "e": 73.836
  },
  {
   "text": "motorlu karavan, hapishane minibüsü ve binek otomobili",
   "s": 73.836,
   "e": 76.956
  },
  {
   "text": "87.03'te;",
   "s": 76.956,
   "e": 78.516
  },
  {
   "text": "beton mikser ve kurtarıcı ise 87.05'te.",
   "s": 78.516,
   "e": 82.006
  },
  {
   "text": "Tuzak nerede?",
   "s": 82.885,
   "e": 84.375
  },
  {
   "text": "Cano, golf arabası spor malzemesidir diye C şıkkını",
   "s": 84.405,
   "e": 87.925
  },
  {
   "text": "seçti.",
   "s": 87.925,
   "e": 88.645
  },
  {
   "text": "Hayır!",
   "s": 88.645,
   "e": 89.365
  },
  {
   "text": "Golf arabası insan taşır;",
   "s": 89.365,
   "e": 91.205
  },
  {
   "text": "87.03'ün açıklama notunda adıyla sayılır,",
   "s": 91.205,
   "e": 94.285
  },
  {
   "text": "tıpkı motorlu karavan gibi.",
   "s": 94.285,
   "e": 95.952
  },
  {
   "text": "Bir de dikkat:",
   "s": 95.952,
   "e": 97.005
  },
  {
   "text": "Ambulans ile cenaze arabasını özel amaçlı sanıp",
   "s": 97.005,
   "e": 99.765
  },
  {
   "text": "87.05'e götürmek de sık yapılan bir hatadır.",
   "s": 99.765,
   "e": 103.165
  },
  {
   "text": "Kısa yol:",
   "s": 103.165,
   "e": 104.005
  },
  {
   "text": "Taşıt insan mı taşıyor,",
   "s": 104.005,
   "e": 105.565
  },
  {
   "text": "yoksa hizmet mi veriyor?",
   "s": 105.565,
   "e": 107.323
  },
  {
   "text": "İkinci soru.",
   "s": 108.073,
   "e": 109.123
  },
  {
   "text": "İçine kurşun doldurularak ağırlaştırılmış,",
   "s": 109.273,
   "e": 111.913
  },
  {
   "text": "savunma amacıyla da kullanılabilen yürüyüş bastonu,",
